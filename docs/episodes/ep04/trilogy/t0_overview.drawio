        <mxCell id="sick" value="ep03 的 150ms，其实是两种卡：自己——按键到动隔着一个来回；别人——快照一格一格，抽搐瞬移" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=24;fontColor=#990000;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="1780" height="100" as="geometry"/></mxCell>

        <mxCell id="h1" value="① 预测 · 手感不等网络" style="text;fontSize=26;fontStyle=1;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="296" width="540" height="42" as="geometry"/></mxCell>
        <mxCell id="c1" value="按键当场动，这一步不等任何人&#10;输入照发——账，先记下" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="70" y="345" width="540" height="285" as="geometry"/></mxCell>
        <mxCell id="h2" value="② 和解 · 权威兜底" style="text;fontSize=26;fontStyle=1;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="690" y="296" width="540" height="42" as="geometry"/></mxCell>
        <mxCell id="c2" value="拿确认号翻底账，三方对账&#10;误差超 5 厘米：摆回重抄" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="690" y="345" width="540" height="285" as="geometry"/></mxCell>
