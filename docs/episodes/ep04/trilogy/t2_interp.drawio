<mxfile host="app.diagrams.net">
  <diagram name="远端插值管线" id="t2_interp">
    <mxGraphModel dx="1500" dy="900" grid="0" page="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell>
        <mxCell id="title" value="远端插值管线——快照连成线，渲染点沿线滑" style="text;fontSize=38;fontStyle=1;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="1300" height="60" as="geometry"/></mxCell>
        <mxCell id="stamp" value="插值图 · 草案 v1 · 2026-10-23" style="text;fontSize=18;fontColor=#999999;align=right;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1500" y="52" width="350" height="34" as="geometry"/></mxCell>

        <mxCell id="p1" value="① 快照到达&#10;33ms 一拍 · TCP 有序" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=22;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="p2" value="② 滑动窗口&#10;SnapA / SnapB 两点&#10;新到顶掉最老" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="p3" value="③ 渲染点 = now − 25ms&#10;两点间匀速夹取&#10;（真插值，不是追新）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="940" y="150" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="p4" value="快照迟到&#10;顺着线往前探&#10;封顶 200ms（防穿墙）" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=20;fontColor=#990000;dashed=1;dashPattern=8 4;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1450" y="140" width="380" height="160" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=none;strokeColor=#666666;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="210" as="sourcePoint"/><mxPoint x="510" y="210" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=none;strokeColor=#666666;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="210" as="sourcePoint"/><mxPoint x="940" y="210" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=none;strokeColor=#b85450;strokeWidth=3;endArrow=block;endFill=1;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="220" as="sourcePoint"/><mxPoint x="1450" y="220" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="rail" value="这条线，就是那条铁轨——渲染点只是走在路上" style="text;fontSize=24;fontStyle=1;fontColor=#d6b656;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="510" y="330" width="810" height="44" as="geometry"/></mxCell>

        <mxCell id="p5" value="④ 动画速度 = Δ位移 / Δack 拍&#10;用发端的账算，不用墙上的钟——&#10;到达抖动骗不了它" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=22;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="520" height="150" as="geometry"/></mxCell>

        <mxCell id="fil" value="⑤ 三层滤波——三层噪声，三层各管一段" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#333333;fontSize=22;fontStyle=1;align=right;verticalAlign=top;spacing=6;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="1750" height="270" as="geometry"/></mxCell>
        <mxCell id="fl1" value="第 1 层 · 到达抖动&#10;快照迟到有 25ms 余量兜着&#10;（窗口吸收，不需滤波器）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="120" y="680" width="520" height="170" as="geometry"/></mxCell>
        <mxCell id="fl2" value="第 2 层 · 发端上报间隔 20~46ms 乱跳&#10;非对称低通：升速慢 α0.1 滤抖&#10;降速快 α0.25 不拖尾" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="710" y="680" width="530" height="170" as="geometry"/></mxCell>
        <mxCell id="fl3" value="第 3 层 · 停步残影&#10;低速 &lt; 15 直接归零&#10;速度封顶 420（不误触顶格）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1310" y="680" width="490" height="170" as="geometry"/></mxCell>

        <mxCell id="e5fil" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.423;entryY=0;" edge="1" parent="1" source="p5" target="fl1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eFil12" value="" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="765" as="sourcePoint"/><mxPoint x="710" y="765" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="eFil23" value="" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="765" as="sourcePoint"/><mxPoint x="1310" y="765" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="self" value="本地自机豁免：自机走对账（旅程图），缓冲恒空——两套管线互不打架（契约 v4.1 含己）" style="text;fontSize=18;fontColor=#999999;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="700" y="440" width="1130" height="40" as="geometry"/></mxCell>
        <mxCell id="eSelf" value="" style="edgeStyle=none;strokeColor=#999999;strokeWidth=2;endArrow=none;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="480" as="sourcePoint"/><mxPoint x="600" y="480" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="banner" value="渲染延迟只伸不跳——追不上贴最老，断流贴最新" style="rounded=0;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;strokeWidth=2;fontSize=30;fontStyle=1;align=center;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="1780" height="80" as="geometry"/></mxCell>
        <mxCell id="foot" value="图=代码：kInterpDelaySec=25ms / MaxExtrapolation=200ms / VelAlpha 0.1·0.25 / 断 15 / 封 420 = SightlineCharacter.cpp TickRemoteInterpolation" style="text;fontSize=15;fontColor=#999999;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="1020" width="1500" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
