        <mxCell id="fl3" value="第 3 层 · 停步残速&#10;速度 &lt; 15 归零&#10;上限钳制 420（防误触满速动画）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1310" y="680" width="490" height="170" as="geometry"/></mxCell>

