        <mxCell id="m2n" value="同输入被两拍采样（ack 重复）——置零会闪回 Idle" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="810" y="405" width="420" height="22" as="geometry"/></mxCell>

