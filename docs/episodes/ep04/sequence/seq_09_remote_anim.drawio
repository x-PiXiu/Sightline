        <mxCell id="m4l" value="反例：用接收时距当分母 → 段速度 0↔800 来回摆" style="text;fontSize=15;fontStyle=1;align=center;fontColor=#990000;" vertex="1" parent="1"><mxGeometry x="545" y="502" width="420" height="26" as="geometry"/></mxCell>

