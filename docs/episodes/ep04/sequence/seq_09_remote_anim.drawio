        <mxCell id="m5l" value="VelAlpha = (SegVel.Size2D() &lt; Smoothed.Size2D()) ? 0.25 : 0.1" style="text;fontSize=15;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="978" y="626" width="520" height="26" as="geometry"/></mxCell>
        <mxCell id="m5n" value="非对称低通 · 升速慢降速快" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="978" y="662" width="320" height="22" as="geometry"/></mxCell>

