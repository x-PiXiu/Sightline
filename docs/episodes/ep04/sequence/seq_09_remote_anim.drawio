        <mxCell id="m6n" value="升速 α0.1 滤发端间隔抖动 · 降速 α0.25 让停步 250ms 落 Idle" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="978" y="742" width="500" height="22" as="geometry"/></mxCell>

