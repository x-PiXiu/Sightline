        <mxCell id="m10l" value="AnimInputs.DirectionAngle = ±Acos(Dot(Fwd, Dir))" style="text;fontSize=15;fontStyle=1;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="620" y="1068" width="420" height="26" as="geometry"/></mxCell>
        <mxCell id="m10n" value="0=前 · 负=左 · 正=右（BS_Unarmed_Move 的 Direction 轴）" style="text;fontSize=14;align=center;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="620" y="1102" width="450" height="22" as="geometry"/></mxCell>

