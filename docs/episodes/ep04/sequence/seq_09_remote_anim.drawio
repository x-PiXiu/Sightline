        <mxCell id="m3l" value="SegVel = (SnapB.Pos − SnapA.Pos) × (30 / DAck)" style="text;fontSize=15;fontStyle=1;align=center;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="545" y="436" width="420" height="26" as="geometry"/></mxCell>
        <mxCell id="m3n" value="服务器 tick 与客户端输入是两个时钟，采样会撞拍 / 跳拍" style="text;fontSize=14;align=center;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="545" y="470" width="460" height="22" as="geometry"/></mxCell>

