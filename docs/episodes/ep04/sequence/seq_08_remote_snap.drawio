        <mxCell id="m12" style="edgeStyle=none;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="1128" as="sourcePoint"/><mxPoint x="1575" y="1158" as="targetPoint"/><Array as="points"><mxPoint x="1655" y="1128"/><mxPoint x="1655" y="1158"/></Array></mxGeometry></mxCell>
        <mxCell id="m12l" value="Tick(DeltaSeconds) → TickRemoteInterpolation(DeltaTime)" style="text;fontSize=15;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="1122" width="480" height="26" as="geometry"/></mxCell>
        <mxCell id="m12n" value="每帧执行 · SnapCount &lt; 2 时直接 return" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="700" y="1158" width="420" height="22" as="geometry"/></mxCell>

        <mxCell id="m13" style="edgeStyle=none;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="1202" as="sourcePoint"/><mxPoint x="1575" y="1232" as="targetPoint"/><Array as="points"><mxPoint x="1655" y="1202"/><mxPoint x="1655" y="1232"/></Array></mxGeometry></mxCell>
        <mxCell id="m13l" value="RenderTime = Now − kInterpDelaySec" style="text;fontSize=15;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="1196" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="m13n" value="kInterpDelaySec = 25ms &lt; 快照间隔 33ms —— 渲染点落在 AB 窗口内真插值" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="700" y="1232" width="580" height="22" as="geometry"/></mxCell>

        <mxCell id="m14" style="edgeStyle=none;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="1288" as="sourcePoint"/><mxPoint x="1575" y="1318" as="targetPoint"/><Array as="points"><mxPoint x="1655" y="1288"/><mxPoint x="1655" y="1318"/></Array></mxGeometry></mxCell>
        <mxCell id="m14l" value="Span = SnapB.TimeSec − SnapA.TimeSec&#10;RawAlpha = (RenderTime − SnapA.TimeSec) / Span" style="text;fontSize=15;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="1274" width="430" height="48" as="geometry"/></mxCell>

        <mxCell id="m15" style="edgeStyle=none;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="1352" as="sourcePoint"/><mxPoint x="1575" y="1382" as="targetPoint"/><Array as="points"><mxPoint x="1655" y="1352"/><mxPoint x="1655" y="1382"/></Array></mxGeometry></mxCell>
        <mxCell id="m15l" value="NewLoc = Lerp(SnapA.Pos, SnapB.Pos, Alpha) → SetActorLocation(NewLoc)" style="text;fontSize=15;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="1346" width="560" height="26" as="geometry"/></mxCell>

        <mxCell id="exF" value="" style="rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="600" y="1465" width="700" height="115" as="geometry"/></mxCell>
        <mxCell id="exT" value="opt 外推" style="rounded=0;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;align=left;spacingLeft=10;fontColor=#990000;" vertex="1" parent="1"><mxGeometry x="600" y="1465" width="150" height="36" as="geometry"/></mxCell>
        <mxCell id="m16" style="edgeStyle=none;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="1515" as="sourcePoint"/><mxPoint x="1575" y="1545" as="targetPoint"/><Array as="points"><mxPoint x="1655" y="1515"/><mxPoint x="1655" y="1545"/></Array></mxGeometry></mxCell>
        <mxCell id="m16l" value="Alpha = Clamp(RawAlpha, 0, 1 + MaxExtrapolation/Span)" style="text;fontSize=15;align=left;fontColor=#990000;" vertex="1" parent="1"><mxGeometry x="790" y="1509" width="440" height="26" as="geometry"/></mxCell>
        <mxCell id="m16n" value="MaxExtrapolation = 200ms —— 防冻结，限幅防急停过冲穿墙" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="790" y="1545" width="460" height="22" as="geometry"/></mxCell>

        <mxCell id="m17" style="edgeStyle=none;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1575" y="1615" as="sourcePoint"/><mxPoint x="1575" y="1645" as="targetPoint"/><Array as="points"><mxPoint x="1655" y="1615"/><mxPoint x="1655" y="1645"/></Array></mxGeometry></mxCell>
        <mxCell id="m17l" value="TargetYaw = SnapA.Yaw + FindDeltaAngleDegrees(SnapA.Yaw, SnapB.Yaw) × Alpha" style="text;fontSize=15;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="1609" width="620" height="26" as="geometry"/></mxCell>
        <mxCell id="m17n" value="最短弧插值 · 避免 179° ↔ −179° 绕远路" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="700" y="1645" width="420" height="22" as="geometry"/></mxCell>

