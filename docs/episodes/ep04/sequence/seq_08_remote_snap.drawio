        <mxCell id="m18l" value="NewRot = RInterpTo(CurRot, TargetYaw, DeltaTime, kRotInterpSpeed)" style="text;fontSize=15;align=left;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="1686" width="540" height="26" as="geometry"/></mxCell>
        <mxCell id="m18n" value="kRotInterpSpeed = 10 —— 朝向平滑，非线性逼近" style="text;fontSize=14;align=left;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="700" y="1722" width="420" height="22" as="geometry"/></mxCell>

        <mxCell id="concl" value="读法：一条 29 字节的快照从左蓝进，经三层派发落到右黄的插值本体；核心是 SnapA/SnapB 两帧窗口——&#10;首帧直摆、次帧凑窗、此后滑动。渲染点比当前时刻早 25ms，保证永远在两帧之间「真插值」而非跳格。" style="rounded=0;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;strokeWidth=2;fontSize=16;fontStyle=1;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="1795" width="1080" height="92" as="geometry"/></mxCell>

