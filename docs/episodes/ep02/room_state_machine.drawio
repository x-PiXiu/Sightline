<mxfile host="app.diagrams.net">
  <diagram name="房间状态机" id="roomsm">
    <mxGraphModel dx="1300" dy="900" grid="0" page="1" pageWidth="1200" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="房间状态机（第 2 期 · 服务器权威）" style="text;fontSize=22;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="700" height="34" as="geometry"/></mxCell>

        <mxCell id="n_ne" value="未创建&#10;（房间不存在）" style="rounded=1;whiteSpace=wrap;fillColor=none;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=15;fontColor=#666666;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="n_wait" value="Waiting · 等待中&#10;1 ~ 3 人&#10;房主 = 最早加入者" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="n_full" value="Full · 满员&#10;恰好 4 人 · Join 拒绝(码3)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="860" y="200" width="270" height="110" as="geometry"/></mxCell>

        <mxCell id="e_create" value="① 创建（CREATE 成功→roomId）&#10;CREATE 拒绝码：1 未登录 · 2 已在房 · 3 房名非法" style="endArrow=block;html=1;strokeColor=#c8161d;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#c8161d;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1" source="n_ne" target="n_wait"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_stay" value="⑤ 离开 · 仍 ≥1 人（本态保持）" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#1f4e79;sketch=1;curveFitting=1;jiggle=2;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" parent="1" source="n_wait" target="n_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="155"/><mxPoint x="610" y="155"/></Array></mxGeometry></mxCell>
        <mxCell id="e_fill" value="② 加入 · 人数满 4" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2.5;fontSize=13;fontColor=#1f4e79;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1" source="n_wait" target="n_full"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_drain" value="③ 离开 · 人数 −1（Full → Waiting）" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2.5;fontSize=13;fontColor=#1f4e79;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;exitX=0.75;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="n_full" target="n_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="345"/><mxPoint x="615" y="345"/></Array></mxGeometry></mxCell>
        <mxCell id="e_dissolve" value="④ 离开/断线 · 人数归 0 → 解散（房间消失，全大厅 ROOM_LIST 刷新）" style="endArrow=block;html=1;strokeColor=#c8161d;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#c8161d;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;exitX=0.25;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n_wait" target="n_ne"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="345"/><mxPoint x="180" y="345"/></Array></mxGeometry></mxCell>

        <mxCell id="note_host" value="房主规则：房主离开/断线 → 转移给剩余成员中最早加入者（成员表首位自动成立——不写特判）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="370" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="note_disc" value="断线 = 同 LEAVE 路径（D2-16）：服务器不区分“走”与“死”，统一走离房→房主转移判定→推送" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="420" y="370" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="note_join" value="进房其余拒绝码：1 未登录 · 2 房间不存在 · 4 已在房间——全部由服务器校验，客户端只发意图" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="760" y="370" width="370" height="100" as="geometry"/></mxCell>

        <mxCell id="auth" value="服务器说了算：满员/存在性/房主归属的校验全在服务器——客户端只发意图（消息 4/6/8/10），一切状态以推送（11/12）与回执（5/7/9）为准" style="rounded=1;whiteSpace=wrap;fillColor=#fff5f5;strokeColor=#c8161d;strokeWidth=2;fontSize=14;fontStyle=1;align=center;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="1050" height="60" as="geometry"/></mxCell>

        <mxCell id="legend" value="灰虚 = 不存在　绿 = 等待中　橙 = 满员　红 = 创建/解散与权威规则　黄 = 设计注记　|　注：Waiting/Full 由成员数推导（服务器未存状态字段，状态机是教学画法）　|　底图：第 2 期设计草案 §4/§5（图 = 代码一致）" style="text;fontSize=13;fontColor=#555555;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="1060" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
