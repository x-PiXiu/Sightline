        <mxCell id="c3" value="    if (!P.IsValidIndex(Off))    return false;   // 下标先验" style="text;fontSize=15;fontColor=#e8e8e8;align=left;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="152" width="1060" height="22" as="geometry"/></mxCell>
        <mxCell id="c4" value="    if (Off + 1 + Len &gt; P.Num()) return false;   // 越界先验" style="text;fontSize=15;fontColor=#ffd54a;fontStyle=1;align=left;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="1060" height="22" as="geometry"/></mxCell>
        <mxCell id="c5" value="    Out = FromUtf8(P.GetData() + Off + 1, Len);" style="text;fontSize=15;fontColor=#e8e8e8;align=left;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="208" width="1060" height="22" as="geometry"/></mxCell>
        <mxCell id="c6" value="}" style="text;fontSize=15;fontColor=#e8e8e8;align=left;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="236" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="c7" value="// 调用侧：ParseRoomState 返回 false → break —— 整包丢弃，绝不带病入库" style="text;fontSize=15;fontColor=#7ec699;align=left;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="286" width="1060" height="24" as="geometry"/></mxCell>
        <mxCell id="mark" value="对端字节 = 伪造候选" style="text;fontSize=16;fontStyle=1;fontColor=#ffd54a;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="360" height="26" as="geometry"/></mxCell>
        <mxCell id="note" value="对端不可信是双向的：服务器不信客户端的意图，客户端也不信服务器的字节——模型只收验过身的数据" style="text;fontSize=14;fontColor=#555555;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="1120" height="24" as="geometry"/></mxCell>
