        <mxCell id="bar" value="Lobby/SightlineLobby.cpp —— 解析侧：对端字节同样不可信" style="text;fontSize=15;fontStyle=1;fontColor=#aab2c0;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="44" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="c1" value="// 解析 [1B len][utf8]；越界返回 false —— 任何字段先验长度再解包" style="text;fontSize=15;fontColor=#7ec699;align=left;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="70" y="84" width="1060" height="24" as="geometry"/></mxCell>
