<mxfile host="app.diagrams.net">
  <diagram name="UI流程图" id="uiflow">
    <mxGraphModel dx="1300" dy="900" grid="0" page="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="客户端 UI 流程 + UI–C++ 分层（第 2 期 · 蓝图=0，皮在 WBP / 逻辑在 C++）" style="text;fontSize=22;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="980" height="34" as="geometry"/></mxCell>

        <mxCell id="w_login" value="WBP_Login · 登录界面&#10;&#10;NameInput 名字输入&#10;LoginButton 登录&#10;MessageText 状态/报错" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=3;fontSize=14;fontStyle=1;align=center;spacing=4;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="70" y="80" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="w_lobby" value="WBP_Lobby · 大厅&#10;&#10;RoomListText 房间列表&#10;RoomNameInput + CreateButton 建房&#10;RoomIdInput + JoinButton 进房&#10;MessageText 失败提示" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=3;fontSize=14;fontStyle=1;align=center;spacing=4;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="455" y="80" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="w_room" value="WBP_Room · 房间等待页&#10;&#10;RoomTitleText 房号&#10;MemberListText 成员（首位★房主）&#10;LeaveButton 离开回大厅" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=3;fontSize=14;fontStyle=1;align=center;spacing=4;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="850" y="80" width="290" height="170" as="geometry"/></mxCell>

        <mxCell id="t1" value="登录成功&#10;LOGIN_RESULT(码0)" style="endArrow=block;html=1;strokeColor=#c8161d;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#c8161d;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1" source="w_login" target="w_lobby"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="115" as="sourcePoint"/><mxPoint x="455" y="115" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t2" value="建房/进房成功&#10;ROOM_STATE 推送到达" style="endArrow=block;html=1;strokeColor=#c8161d;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#c8161d;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1" source="w_lobby" target="w_room"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="115" as="sourcePoint"/><mxPoint x="850" y="115" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t3" value="离开 / 收到 ROOM_LIST = 此刻人在大厅（幂等：已在大厅只刷新）" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#1f4e79;sketch=1;curveFitting=1;jiggle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="w_room" target="w_lobby"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="330"/><mxPoint x="605" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="t4" value="KICKED(码1顶号/2超时/3关服) 或链路断开 → 回登录界面（bShuttingDown 拆卸中不建界面）" style="endArrow=block;html=1;strokeColor=#c8161d;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#c8161d;sketch=1;curveFitting=1;jiggle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="w_lobby" target="w_login"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="420"/><mxPoint x="215" y="420"/></Array></mxGeometry></mxCell>

        <mxCell id="session" value="ULobbySession · 会话层（C++，蓝图 = 0 逻辑）&#10;&#10;意图接口（只发包）：Login / CreateRoom / JoinRoom / LeaveRoom&#10;收帧解析(4~13) → 更新 FLobbyModel → BlueprintAssignable 委托刷新界面" style="rounded=1;whiteSpace=wrap;fillColor=#fff5f5;strokeColor=#c8161d;strokeWidth=3;fontSize=15;fontStyle=1;align=left;spacing=6;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="1070" height="130" as="geometry"/></mxCell>

        <mxCell id="f_intent" value="按钮点击 → 意图（三界面同路，只发包）" style="endArrow=block;html=1;strokeColor=#c8161d;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#c8161d;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="w_lobby" target="session"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="450"/><mxPoint x="817" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="f_deleg1" value="委托刷新（模型 → 界面）" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#1f4e79;sketch=1;curveFitting=1;jiggle=2;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="session" target="w_login"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="f_deleg2" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2.5;sketch=1;curveFitting=1;jiggle=2;exitX=0.7;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="session" target="w_room"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="f_deleg3" value="" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2.5;sketch=1;curveFitting=1;jiggle=2;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="session" target="w_lobby"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="450"/></Array></mxGeometry></mxCell>

        <mxCell id="bindnote" value="BindWidget：WBP 控件按名字咬合 C++ 基类——三个 WBP 的根类必须设为对应 WidgetBase（★名错一字即“未绑定”，界面留空）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=6;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="70" y="625" width="700" height="55" as="geometry"/></mxCell>
        <mxCell id="legend" value="红 = 界面切换与意图　蓝 = 服务器推送驱动的委托刷新　黄 = 绑定注记　|　来源：第 2 期设计草案 §2.2 + UI 线（图 = 代码一致）" style="text;fontSize=13;fontColor=#555555;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="790" y="640" width="400" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
