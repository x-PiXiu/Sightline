<mxfile host="app.diagrams.net">
  <diagram name="新版业务流程" id="newflow1">
    <mxGraphModel dx="1300" dy="900" grid="0" page="1" pageWidth="1300" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="新版业务流程 · 第 1 期（UE 连接 + 心跳 ping 的完整旅程 · 单线程版）" style="text;fontSize=24;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="36" as="geometry"/></mxCell>

        <mxCell id="ue_head" value="UE 客户端" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="240" height="55" as="geometry"/></mxCell>
        <mxCell id="sv_head" value="服务器主线程（第 1 期单线程：net → codec → 逻辑帧 同一线程）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="560" height="55" as="geometry"/></mxCell>
        <mxCell id="line_ue" value="" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="125" as="sourcePoint"/><mxPoint x="240" y="1010" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="line_sv" value="" style="endArrow=none;dashed=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="125" as="sourcePoint"/><mxPoint x="900" y="1010" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m1" value="① TCP 连接请求" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="175" as="sourcePoint"/><mxPoint x="900" y="175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s2" value="② Acceptor：accept → 新建 ClientConnection（生命周期托管）" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="910" y="200" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="m3" value="③ WELCOME [serverTime]" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="290" as="sourcePoint"/><mxPoint x="240" y="290" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s4" value="④ HUD：Connected ✅&#10;（本期验收画面 ①）" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="325" width="330" height="60" as="geometry"/></mxCell>

        <mxCell id="m5" value="⑤ HEARTBEAT [seq, clientTs]（每秒一次）" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="440" as="sourcePoint"/><mxPoint x="900" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s6" value="⑥ read → RecvBuffer → FrameCodec 切帧&#10;【net + adapters】不足一帧就留在缓冲等下次" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="910" y="470" width="370" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="⑦ 33ms 帧驱动：从帧队列取消息&#10;【逻辑】会话校验 → 限频钩子 → 组 ACK" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="910" y="560" width="370" height="60" as="geometry"/></mxCell>
        <mxCell id="m8" value="⑧ HEARTBEAT_ACK [seq]" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="670" as="sourcePoint"/><mxPoint x="240" y="670" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s9" value="⑨ ping = now − clientTs → HUD 显示 ✅&#10;（本期验收画面 ②）" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="705" width="330" height="60" as="geometry"/></mxCell>

        <mxCell id="brk" value="断开感知：read 返回 0 / EPOLLERR → ClientConnection 清理 → 上层收到断开事件（第 2 期接会话注销）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontColor=#555;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="910" y="670" width="370" height="70" as="geometry"/></mxCell>

        <mxCell id="note" value="三点说明（上镜讲稿）&#10;· 第 1 期全流程单线程——net、codec、逻辑帧在同一个 EventLoop，无跨线程投递&#10;· 消息最多等一个帧周期（33ms）才被处理——这是帧驱动的固有节奏，换来的是世界状态绝对一致&#10;· ②⑥⑦ 三个框就是现状图上那面「缺失红墙」被补齐后的样子——同一流程路径，红节点换成了新设计" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=16;fontColor=#990000;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1240" height="150" as="geometry"/></mxCell>

        <mxCell id="legend" value="色标：绿箭头=服务器→UE　蓝箭头=UE→服务器&#10;蓝框=net/adapters　橙框=逻辑帧　蓝框(UE侧)=验收画面" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontColor=#333;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1240" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
