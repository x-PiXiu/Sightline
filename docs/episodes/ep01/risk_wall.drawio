<mxfile host="app.diagrams.net">
  <diagram name="六隐患便签墙" id="riskwall">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="交接批注 · 六条隐患（读码时记下的）" style="text;fontSize=26;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="900" height="44" as="geometry"/></mxCell>

        <mxCell id="r1" value="① 缺 TCP 连接抽象&#10;━━━━━&#10;accept 完直接跳协议解析，&#10;没有「连接」这个对象管生死" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="r2" value="② 时间轮用 weak_ptr 存定时器&#10;━━━━━&#10;存储不拥有对象，&#10;过期/取消场景会「全部失效」" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="r3" value="③ 回调丢通用线程池并行跑&#10;━━━━━&#10;多个请求同时改共享状态，&#10;没有任何保护 —— 状态竞争" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="r4" value="④ 网络层耦合配置中心和业务线程池&#10;━━━━━&#10;头文件直接 include 业务模块，&#10;想单独复用/测试都扯出一串依赖" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="r5" value="⑤ SIGPIPE 靠每个 main 自觉&#10;━━━━━&#10;网络库不管，忘了写就静默崩溃" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="r6" value="⑥ epoll 100ms 轮询，无 timerfd&#10;━━━━━&#10;定时精度差、空闲空转烧 CPU" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="940" y="260" width="400" height="130" as="geometry"/></mxCell>

        <mxCell id="status" value="处置状态：③④ 已在解耦手术中切除 ✅　·　②⑥ 转演进项（按需触发）　·　①⑤ 第 1 期/后续补齐&#10;细节全部留到第 13 期「事故复盘」展开——本图只报存在，不展开原理。" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=15;fontColor=#990000;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1280" height="100" as="geometry"/></mxCell>

        <mxCell id="note" value="这张图的用法：口播讲「记了六条隐患」时全景入画；逐条讲时镜头推对应便签特写。" style="text;fontSize=14;fontColor=#888;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="1000" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
