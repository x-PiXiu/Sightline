<mxfile host="app.diagrams.net">
  <diagram name="帧队列机制" id="framequeue">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="帧队列 · 消息处理机制（第 1 期版）" style="text;fontSize=26;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="900" height="44" as="geometry"/></mxCell>

        <mxCell id="in1" value="心跳帧到达" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="in2" value="更多帧到达…" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;sketch=1;curveFitting=1;jiggle=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="200" height="50" as="geometry"/></mxCell>

        <mxCell id="queue" value="帧队列 std::deque&#10;━━━━━━━&#10;[心跳帧] [心跳帧] [ … ]&#10;先到先排，只在 loop 线程消费" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;align=left;spacing=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="e1" value="收到完整帧 → 入队" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontColor=#333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="in1" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="tick" value="33ms 帧&#10;（runEvery 定时驱动）" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="460" y="300" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="e2" value="每 33ms 醒一次：&#10;把队列里的帧全部取出处理" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d79b00;strokeWidth=2;fontSize=14;fontColor=#8a4b00;exitX=0;exitY=0.5;entryX=1;entryY=1;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="tick" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="proc" value="逐帧处理&#10;━━━━━━━&#10;心跳帧 → 校验 seq&#10;→ 组 ACK → 回包" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacing=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="e3" value="帧循环：取出 → 处理 → 清空" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontColor=#1f6b30;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="queue" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="why" value="为什么排队？━━━━━━━&#10;· 现在只有心跳——echo 就够，排队看似多此一举&#10;· 但第 3 期同步上线后：一帧内可能涌入移动/开枪/道具多种消息——&#10;　帧队列就是「世界按帧推进」的地基，第 1 期打桩，第 3 期起楼&#10;· 成本：一个 std::deque，忽略不计" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=15;fontColor=#990000;align=left;spacing=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1060" height="170" as="geometry"/></mxCell>

        <mxCell id="latency" value="代价说明：消息最多等 33ms 才被处理——帧驱动的固有节奏，&#10;换来的是「每一帧内处理顺序确定」，这就是同步系统的正确性来源" style="text;fontSize=14;fontColor=#555;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1060" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
