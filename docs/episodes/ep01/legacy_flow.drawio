<mxfile host="app.diagrams.net">
  <diagram name="旧版业务流程" id="legacy1">
    <mxGraphModel dx="1300" dy="900" grid="0" page="1" pageWidth="1300" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="旧版业务流程 · 毕设网络库（一个 HTTP/WebSocket 请求的一生）" style="text;fontSize=24;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1000" height="36" as="geometry"/></mxCell>

        <mxCell id="s1" value="main 启动&#10;读 ConfigManager → 建 EventLoop → HTTP/WS Server 挂监听 → loop()" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="70" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="s2" value="客户端请求到达（HTTP / WebSocket）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="180" width="620" height="56" as="geometry"/></mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s3" value="epoll_wait 返回就绪 → Channel 分发&#10;（listen fd → accept 新连接 ｜ conn fd → read 数据）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="276" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s4" value="应用层解析协议（HTTP 报文 / WebSocket 握手与帧）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="386" width="620" height="56" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s5" value="⚠️ 隐患③ 业务回调丢「通用 ThreadPool」并行执行&#10;多个请求并行改共享状态，无任何保护 —— 状态竞争" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontColor=#990000;" vertex="1" parent="1"><mxGeometry x="120" y="482" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s6" value="组响应 → 写回客户端" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="592" width="620" height="56" as="geometry"/></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s7" value="⚠️ 隐患⑤ 客户端断开后写 socket → SIGPIPE&#10;网络库不管——靠每个 main 记得手写 signal 忽略，忘了就静默崩溃" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontColor=#990000;dashed=1;" vertex="1" parent="1"><mxGeometry x="120" y="688" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="s8" value="定时支线：时间轮 tick 推进（心跳/超时）&#10;⚠️ 隐患② weak_ptr 存定时器　⚠️ 隐患⑥ epoll 100ms 轮询，无 timerfd 精准唤醒" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontColor=#990000;" vertex="1" parent="1"><mxGeometry x="120" y="798" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="verdict" value="结论：底座（绿）能跑通 Web 请求，但三个红节点决定了它干不了 FPS——&#10;① 无 TCP 连接抽象（流程从 accept 后直接跳协议解析，没有连接对象管理生命周期）&#10;③ 回调并行跑（游戏世界状态必须串行）　⑤⑥ 定时与信号靠人记得&#10;→ 第 1 期工作 = 沿同一条流程路径，把红节点换成新设计（见新版业务流程图）" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=17;fontColor=#990000;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="780" height="170" as="geometry"/></mxCell>

        <mxCell id="legend" value="图例（全系列统一）&#10;绿 = 网络底座（可用）&#10;黄 = Web 业务（FPS 用不上）&#10;红 = 隐患节点&#10;灰 = 启动/装配" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=15;fontColor=#333333;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="880" y="920" width="330" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
