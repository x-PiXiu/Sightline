<mxfile host="app.diagrams.net">
  <diagram name="心跳时序手绘" id="heartbeatseqh">
    <mxGraphModel dx="1300" dy="900" grid="0" page="1" pageWidth="1300" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="心跳 · 双端时序 · 终版（第 1 期 · 单线程 + 帧队列）" style="text;fontSize=24;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1000" height="36" as="geometry"/></mxCell>

        <mxCell id="h_ue" value="UE 客户端&#10;GameInstance / FTimerHandle / HUD" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="66" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="h_sv" value="服务器主线程：net → 切帧 → 帧队列 → 帧驱动" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="560" y="66" width="620" height="60" as="geometry"/></mxCell>
        <mxCell id="l_ue" value="" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="126" as="sourcePoint"/><mxPoint x="210" y="1130" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l_sv" value="" style="endArrow=none;dashed=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="126" as="sourcePoint"/><mxPoint x="870" y="1130" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="pre" value="前置：服务器已启动 · Acceptor 监听 8888 · 日志已装配 · SIGPIPE 已处理" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="760" height="40" as="geometry"/></mxCell>

        <mxCell id="m1" value="① TCP 连接请求" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="220" as="sourcePoint"/><mxPoint x="870" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s2" value="② 接客员：accept → 新建连接（生命周期托管）" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="880" y="248" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="s2b" value="②b 组帧 WELCOME [serverTime] → 发送" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="880" y="306" width="400" height="46" as="geometry"/></mxCell>
        <mxCell id="m3" value="③ WELCOME [serverTime]" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="382" as="sourcePoint"/><mxPoint x="210" y="382" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s4" value="④ HUD：Connected ✅（验收画面①）" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="310" height="52" as="geometry"/></mxCell>

        <mxCell id="m5" value="⑤ HEARTBEAT [seq, clientTs]（每秒一跳）" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="508" as="sourcePoint"/><mxPoint x="870" y="508" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s6" value="⑥ 收包 → 缓冲 → 切帧（半包等待）→ 入帧队列" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="880" y="536" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="s7" value="⑦ 33ms 帧：取帧 → 分发（限频钩子）→ 校验 seq → 组 ACK&#10;单线程串行，世界状态一致" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="880" y="594" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="m8" value="⑧ HEARTBEAT_ACK [seq]" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontColor=#333;background=#f7f4ee;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="694" as="sourcePoint"/><mxPoint x="210" y="694" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s9" value="⑨ seq 匹配 → ping = now − clientTs → HUD ✅（验收画面②）" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="727" width="340" height="52" as="geometry"/></mxCell>

        <mxCell id="x1" value="⚠️ 异常路径：read 0 / EPOLLERR → 连接清理（shared_from_this 防悬垂）→ 上层断开事件（第 2 期接会话注销）" style="edgeStyle=none;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=14;fontColor=#990000;background=#f7f4ee;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="812" as="sourcePoint"/><mxPoint x="210" y="812" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="note" value="三点说明（上镜讲稿）&#10;· 第 1 期全流程单线程——收帧入队、帧内串行处理，世界状态天然一致&#10;· 消息最多等一个帧周期（33ms）——帧驱动的固有节奏，换来回包时序确定、第 3 期同步直接复用帧队列&#10;· ②⑥⑦ 三个框 = 现状架构图「缺失红墙」补齐后的样子——图 = 代码一致" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=15;fontColor=#990000;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1240" height="120" as="geometry"/></mxCell>

        <mxCell id="legend" value="读法：从上往下 = 时间流逝　蓝箭头 = UE 发意图　绿箭头 = 服务器结果　红虚线 = 异常路径　色标全系列统一（绿复用/蓝新增/红隐患/黄演进）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontColor=#333;align=left;spacing=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="1240" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
