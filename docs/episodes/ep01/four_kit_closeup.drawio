<mxfile host="app.diagrams.net">
  <diagram name="四件套特写" id="fourkit">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="网络底座 · 四件套（各司其职）" style="text;fontSize=26;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="900" height="44" as="geometry"/></mxCell>

        <mxCell id="k1" value="Epoll&#10;「盯门的」&#10;━━━━━━━&#10;IO 多路复用：&#10;一个线程盯几千个连接&#10;谁有数据到，它叫谁" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;sketch=1;curveFitting=1;jiggle=2;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="k2" value="EventLoop&#10;「调度的」&#10;━━━━━━━&#10;事件循环：&#10;把「谁敲门」翻译成&#10;「该干什么」，逐件执行" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;sketch=1;curveFitting=1;jiggle=2;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="385" y="110" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="k3" value="定时器&#10;「掐表的」&#10;━━━━━━━&#10;时间轮：&#10;心跳、超时、重连——&#10;所有「到点要做的事」归它" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;sketch=1;curveFitting=1;jiggle=2;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="k4" value="Logger&#10;「记录的」&#10;━━━━━━━&#10;异步落盘：&#10;发生了什么全记下来&#10;出事时它是唯一目击证人" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;sketch=1;curveFitting=1;jiggle=2;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="1035" y="110" width="300" height="230" as="geometry"/></mxCell>

        <mxCell id="concl" value="一句话：盯门的、调度的、掐表的、记录的——各司其职，谁也不抢谁的活。" style="text;fontSize=18;fontStyle=1;fontColor=#c8161d;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="1280" height="40" as="geometry"/></mxCell>
        <mxCell id="src" value="代码位置：server/src/net/ + server/include/net/" style="text;fontSize=14;fontColor=#888;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="700" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
