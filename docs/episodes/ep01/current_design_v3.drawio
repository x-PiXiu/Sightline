<mxfile host="app.diagrams.net">
  <diagram name="现状架构手绘风" id="netarchv3">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1400" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="前任的网络库 · 现状（v3）" style="text;fontSize=28;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="900" height="44" as="geometry"/></mxCell>

        <mxCell id="ue" value="UE 客户端&#10;需要：TCP 长连接 · 自定义协议" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="540" height="70" as="geometry"/></mxCell>

        <mxCell id="wall" value="缺少：连接接受 · 连接生命周期 · 收发缓冲（第 1 期补齐）" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;fontColor=#990000;dashed=1;dashPattern=8 4;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="360" y="215" width="620" height="70" as="geometry"/></mxCell>
        <mxCell id="arr1" value="" style="edgeStyle=none;strokeColor=#b85450;strokeWidth=3;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ue" target="wall"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arr1t" value="当前不可达" style="text;fontSize=15;fontColor=#990000;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="140" height="30" as="geometry"/></mxCell>

        <mxCell id="base" value="网络底座 · 可复用" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;fontStyle=1;fontColor=#1f6b30;verticalAlign=top;spacingTop=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="120" y="340" width="1120" height="380" as="geometry"/></mxCell>

        <mxCell id="hero" value="EventLoop&#10;事件循环" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=21;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="560" y="415" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="c1" value="Epoll&#10;IO 多路复用" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="170" y="425" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="c2" value="Channel&#10;事件分发" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="365" y="425" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="c3" value="Socket&#10;bind / listen / accept" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="850" y="425" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="c4" value="HierarchicalTimingWheel&#10;定时器 · 已知设计缺陷" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="170" y="585" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="c5" value="Logger&#10;需显式初始化，否则静默" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="540" y="585" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="c6" value="InetAddress" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="880" y="595" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="hero"><mxGeometry relative="1" as="geometry"/></mxCell>
