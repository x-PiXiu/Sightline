        <mxCell id="e4" value="定时驱动" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontColor=#1f6b30;exitX=0.25;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="hero" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="web" value="HTTP / WebSocket（Web 服务层，FPS 不使用）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="200" height="100" as="geometry"/></mxCell>

        <mxCell id="concl" value="一句话：底座可复用，但缺少 TCP 连接抽象——第 1 期补齐。" style="text;fontSize=19;fontStyle=1;fontColor=#c8161d;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="1300" height="40" as="geometry"/></mxCell>
