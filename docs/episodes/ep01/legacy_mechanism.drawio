<mxfile host="app.diagrams.net">
  <diagram name="老底座机制图" id="legacymech">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="前任网络库 · 机制详图（迁移入 server 的底座 · 真实调用链 v1.0）" style="text;fontSize=25;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="38" as="geometry"/></mxCell>

        <mxCell id="main" value="main.cpp 装配根：addSink(ConsoleSink) → signal(SIGPIPE, SIG_IGN) → EventLoop → InetAddress(8888) → Acceptor → frame_queue → runEvery(33ms)" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="90" y="66" width="1280" height="48" as="geometry"/></mxCell>

        <mxCell id="ue" value="" style="sketch=1;shape=mxgraph.networks.pc;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="90" height="80" as="geometry"/></mxCell>
        <mxCell id="ue_t" value="UE 客户端" style="text;fontSize=14;fontColor=#333;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="130" height="24" as="geometry"/></mxCell>

        <mxCell id="base" value="" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;fontStyle=1;fontColor=#1f4e79;verticalAlign=top;spacingTop=6;align=left;spacingLeft=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="1260" height="620" as="geometry"/></mxCell>
        <mxCell id="base_t" value="EventLoop 单线程世界（event_loop.cpp · 解耦后 648 行）" style="text;fontSize=16;fontStyle=1;fontColor=#1f4e79;align=left;" vertex="1" parent="1"><mxGeometry x="220" y="158" width="700" height="26" as="geometry"/></mxCell>

        <mxCell id="loop1" value="loop()：poller_-&gt;poll(kEpollTimeoutMs = 100ms)　⚠️⑥" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="230" y="205" width="540" height="48" as="geometry"/></mxCell>
        <mxCell id="loop2" value="返回 activeChannels_ → 逐 Channel::handleEvent()" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="230" y="268" width="540" height="44" as="geometry"/></mxCell>
        <mxCell id="le1" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="loop1" target="loop2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="listen" value="listenfd 通道（Acceptor）" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="230" y="345" width="250" height="44" as="geometry"/></mxCell>
        <mxCell id="listen_e" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="listen" target="loop2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="listen_d" value="handleAccept()：accept4 循环（非阻塞）→ 回调 main 新建 ClientConnection 🆕" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="230" y="400" width="250" height="76" as="geometry"/></mxCell>

        <mxCell id="conn" value="connfd 通道（ClientConnection 🆕）&#10;handleRead()：read 循环至 EAGAIN" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="530" y="345" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="conn_e" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="conn" target="loop2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="recv" value="RecvBuffer 攒字节 → FrameCodec 切帧 🆕&#10;半包留缓冲 · 坏流丢弃" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="530" y="412" width="330" height="64" as="geometry"/></mxCell>
        <mxCell id="conn_e2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0288d1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="conn" target="recv"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="queue" value="帧队列 frame_queue（std::deque 🆕）" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="530" y="492" width="330" height="48" as="geometry"/></mxCell>
        <mxCell id="queue_e" value="完整帧 → 入队（main 回调）" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0288d1;strokeWidth=2;fontSize=13;fontColor=#01579b;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="recv" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="frame" value="33ms 帧（runEvery 🆕）&#10;取帧 → 校验 seq → echo ACK" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="530" y="560" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="frame_e" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0288d1;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="queue" target="frame"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ack" value="ACK 回包（ClientConnection::send）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="320" height="56" as="geometry"/></mxCell>
        <mxCell id="ack_e" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="frame" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="timer" value="timerfd 通道 → handleTimerfdRead()&#10;→ timing_wheel_-&gt;tick()　⚠️② weak_ptr 存储缺陷&#10;→ 到期回调执行（runAfter / runEvery）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="230" y="690" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="timer_e" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="timer" target="loop1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="cross" value="queueInLoop(cb) → pendingFunctors_ + eventfd 唤醒 → doPendingFunctors()&#10;（跨线程投递的唯一通道——第 1 期单线程未使用，多线程演进时启用）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontColor=#555;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="830" y="690" width="610" height="70" as="geometry"/></mxCell>

        <mxCell id="logger" value="Logger ✅&#10;需 addSink 装配&#10;⚠️ 否则静默" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="90" y="690" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="log_e" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="logger" target="timer"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="web" value="HTTP / WebSocket 层&#10;（毕设上层 · 未迁入）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontSize=14;fontColor=#888;sketch=1;curveFitting=1;jiggle=2;opacity=70;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="280" height="70" as="geometry"/></mxCell>

        <mxCell id="gaps" value="缺口（第 1 期 🆕 补齐）：Acceptor · ClientConnection · RecvBuffer · FrameCodec · frame_queue" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;fontStyle=1;fontColor=#01579b;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="230" y="790" width="900" height="48" as="geometry"/></mxCell>

        <mxCell id="concl" value="读法：蓝 = 第 1 期新增补缺　绿框 = 前任底座　黄 = 已知隐患（编号②⑥）　灰 = 未迁入/未使用&#10;本图 = server 迁入代码的真实调用链（对照 src/net/ 源码可逐行验证）" style="text;fontSize=14;fontColor=#555;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="880" width="1400" height="50" as="geometry"/></mxCell>
