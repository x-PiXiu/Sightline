<mxfile host="app.diagrams.net">
  <diagram name="协议帧格式" id="protoframe">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1500" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Sightline 协议帧格式 · 第 1 期（三条消息 · 小端 · 服务器与 UE 共同契约）" style="text;fontSize=24;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="36" as="geometry"/></mxCell>

        <mxCell id="hdr_title" value="① 通用帧头（每帧必有，4 字节）" style="text;fontSize=17;fontStyle=1;fontColor=#01579b;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="66" width="500" height="28" as="geometry"/></mxCell>
        <mxCell id="hdr_len" value="len（2B）&#10;= 2 + payload" style="rounded=0;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="hdr_msgid" value="msgid（2B）&#10;消息类型" style="rounded=0;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="hdr_pay" value="payload（变长）" style="rounded=0;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="hdr_byte" value="字节序：小端（Little-Endian）——低字节在前&#10;偏移 0 / 2 / 4，一帧总长 = 2 + len" style="text;fontSize=14;fontColor=#555;align=left;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="480" height="60" as="geometry"/></mxCell>

        <mxCell id="w1_title" value="② MSG_S2C_WELCOME = 1（S→C，连接建立即发）" style="text;fontSize=17;fontStyle=1;fontColor=#1f6b30;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="w1_len" value="len=10" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="224" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="w1_mid" value="msgid=1" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="224" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="w1_ts" value="serverNowMs（8B）" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="224" width="280" height="50" as="geometry"/></mxCell>

        <mxCell id="h1_title" value="③ MSG_C2S_HEARTBEAT = 2（C→S，每 1 秒）" style="text;fontSize=17;fontStyle=1;fontColor=#01579b;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="296" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="h1_len" value="len=14" style="rounded=0;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="h1_mid" value="msgid=2" style="rounded=0;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="330" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="h1_seq" value="seq（4B，从 1 递增）" style="rounded=0;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="h1_ts" value="clientTs（8B）" style="rounded=0;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="240" height="50" as="geometry"/></mxCell>

        <mxCell id="a1_title" value="④ MSG_S2C_HEARTBEAT_ACK = 3（S→C，收到即回）" style="text;fontSize=17;fontStyle=1;fontColor=#1f6b30;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="398" width="600" height="28" as="geometry"/></mxCell>
        <mxCell id="a1_len" value="len=22" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="432" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="a1_mid" value="msgid=3" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="180" y="432" width="120" height="50" as="geometry"/></mxCell>
        <mxCell id="a1_seq" value="seq（4B，回显）" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="432" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="a1_ts" value="clientTs（8B，回显）" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="432" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="a1_sts" value="serverTs（8B）" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="432" width="220" height="50" as="geometry"/></mxCell>

        <mxCell id="seq_note" value="UE 侧规则：ACK.seq 与发送记录匹配 → ping = 收到时刻 − clientTs&#10;匹配不上（过期/未知）→ 忽略" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=14;fontColor=#990000;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="680" height="60" as="geometry"/></mxCell>

        <mxCell id="hex_title" value="⑤ 真实报文示例（HEARTBEAT，seq=1，clientTs=1790876960000）" style="text;fontSize=17;fontStyle=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="590" width="800" height="28" as="geometry"/></mxCell>
        <mxCell id="hexbox" value="0E 00 | 02 00 | 01 00 00 00 | 00 E3 1D 9C A0 01 00 00&#10; └ len=14   └ msgid=2   └ seq=1        └ clientTs（小端）" style="rounded=1;whiteSpace=wrap;fillColor=#333333;strokeColor=#333333;fontSize=17;fontColor=#7CFC00;fontFamily=Courier New;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="624" width="940" height="76" as="geometry"/></mxCell>

        <mxCell id="table_title" value="⑥ 字段表" style="text;fontSize=17;fontStyle=1;fontColor=#333;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="724" width="300" height="28" as="geometry"/></mxCell>
        <mxCell id="tbl" value="&lt;table style=&quot;font-size:14px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;background:#f5f5f5;font-weight:bold;&quot;&gt;字段&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;background:#f5f5f5;font-weight:bold;&quot;&gt;偏移&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;background:#f5f5f5;font-weight:bold;&quot;&gt;长度&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;background:#f5f5f5;font-weight:bold;&quot;&gt;类型&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;background:#f5f5f5;font-weight:bold;&quot;&gt;说明&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;len&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;0&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;2B&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;u16&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;= 2 + payload 长度（半包判定依据）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;msgid&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;2B&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;u16&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;消息类型（见登记表）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;seq&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;4B&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;u32&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;心跳序号，从 1 递增（ACK 匹配键）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;clientTs&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;8B&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;u64&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;客户端发送时刻（Unix 毫秒）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;serverTs&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;16&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;8B&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;u64&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px 14px;&quot;&gt;服务器时刻（ACK 独有，将来单向延迟估计）&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;align=left;spacing=12;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="756" width="940" height="230" as="geometry"/></mxCell>

        <mxCell id="contract" value="契约铁律：本图为服务器（protocol/msg_ids.h）与 UE（SightlineProtocol.h）的共同契约——&#10;两端各自实现、逐字节一致；任何改动先改 docs/protocol/MSG_IDS.md 登记表，两端同步后再动代码。谁也不许私改。" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=15;fontColor=#990000;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1420" height="80" as="geometry"/></mxCell>

        <mxCell id="legend" value="色标：绿 = 服务器下发（S→C）　蓝 = 客户端上行（C→S）　黑底绿字 = 真实字节示例　米白 = 契约说明" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontColor=#333;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="1420" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
