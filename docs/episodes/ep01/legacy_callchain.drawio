<mxfile host="app.diagrams.net">
  <diagram name="毕设网络库调用链总图" id="legacyallchains">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="毕设网络库 · 全调用链总图（源码核实版 · 不含 WebSocket 层）" style="text;fontSize=24;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1100" height="36" as="geometry"/></mxCell>
        <mxCell id="hint" value="讲解顺序 = 链0→1→2→3→4→6（空间自上而下）；每链一色边框" style="text;fontSize=14;fontColor=#888;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="24" as="geometry"/></mxCell>

        <mxCell id="z0" value="链0 · 装配（main.cpp 各服务）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontStyle=1;fontColor=#333;verticalAlign=top;spacingTop=4;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1420" height="88" as="geometry"/></mxCell>
        <mxCell id="z0c" value="signal(SIGPIPE, SIG_IGN) ⚠️⑤ 每个 main 手写　→　Logger 单例（不 addSink 则静默 ⚠️⑦）　→　HttpServer::start() → initialize() → event_loop_->loop()（阻塞主线程）" style="text;fontSize=14;fontColor=#555;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="126" width="1390" height="30" as="geometry"/></mxCell>

        <mxCell id="z1" value="链1 · 接客（listen fd）" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;fontColor=#1f4e79;verticalAlign=top;spacingTop=4;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="690" height="330" as="geometry"/></mxCell>
        <mxCell id="z1a" value="EventLoop::loop()　【event_loop.cpp:202】&#10;→ poller_-&gt;poll(100ms) ⚠️⑥　→ activeChannels_" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="640" height="56" as="geometry"/></mxCell>
        <mxCell id="z1b" value="→ Channel::handleEvent()　【channel.cpp:71】&#10;（listen_channel_ 的 readCallback　【http_server.h:578】）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="296" width="640" height="56" as="geometry"/></mxCell>
        <mxCell id="z1e1" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="z1a" target="z1b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z1c" value="→ HttpServer::handleNewConnection()　【http_server.cpp:645】&#10;while（≤100 次/loop 防饿死　:649）&#10;　├ accept(&amp;addr)　【socket.cpp:158】&#10;　├ IP 黑名单 → 拒则 close　:667&#10;　├ fcntl(fd, O_NONBLOCK)　:680 ←connfd 非阻塞手动补&#10;　├ make_shared&lt;HttpSession&gt;(fd, loop, buf 配置)　:684&#10;　├ session_shards_[fd%64]（64 路分段锁）　:719&#10;　└ runInLoop(session-&gt;start())" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="362" width="640" height="152" as="geometry"/></mxCell>
        <mxCell id="z1e2" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="z1b" target="z1c"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="z2" value="链2 · 收包（conn fd）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;fontColor=#1f6b30;verticalAlign=top;spacingTop=4;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="770" y="190" width="690" height="330" as="geometry"/></mxCell>
        <mxCell id="z2a" value="Channel::handleEvent()（session 构造时注册 readCallback&#10;　channel_-&gt;setReadCallback(handleRead)　【http_session.cpp:53】）&#10;→ HttpSession::handleRead()　【http_session.cpp:219】&#10;　状态机检查：仅 READING 读 / PROCESSING 跳过　:231-246&#10;　while(true)：read(fd)　:254&#10;　　n&gt;0 → input_buffer_.append → continue（ET 循环）&#10;　　n==0 → should_close（对端关闭）&#10;　　EAGAIN → break（读干净）&#10;→ parseHttpRequest()　:295（半包则留缓冲等下次）&#10;　⚠️ 连接对象与 HTTP 协议焊死：状态机+解析器都是 HTTP 专用，&#10;　　FPS 自定义二进制协议用不了——缺口的本质" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="790" y="230" width="650" height="282" as="geometry"/></mxCell>
        <mxCell id="z2e" value="成功则 setState(PROCESSING) → 进链3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#1f6b30;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="z2a" target="z3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="z3" value="链3 · 处理分叉（全图戏剧中心）" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;fontColor=#8a4b00;verticalAlign=top;spacingTop=4;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="542" width="1420" height="212" as="geometry"/></mxCell>
        <mxCell id="z3a" value="EventLoop::executeCallbackAsync(cb)　【event_loop.cpp:1474】&#10;　if (config_.enable_thread_pool &amp;&amp; thread_pool_)&#10;　　　├ 是 → thread_pool_-&gt;submit(cb)　← N 个工作线程并行执行 ⚠️③&#10;　　　└ 否 → cb()（当前线程同步执行）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="582" width="680" height="146" as="geometry"/></mxCell>
        <mxCell id="z3b" value="↓ 无论哪条分支最终执行：&#10;HttpSession::processHttpRequest()　【http_session.cpp:688】&#10;　→ request_handler_(req, res)&#10;　→ HttpServer::handleHttpRequest　【http_server.cpp:7740】&#10;　　├ HTTP 层黑名单复查　:747&#10;　　├ HttpRouter 分发 → 业务 Handler&#10;　　└ sendResponse → write(fd)" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="770" y="582" width="670" height="146" as="geometry"/></mxCell>
        <mxCell id="z3w" value="⚠️③ 实锤：session 自己有 mutex，但跨 session 的业务共享数据在 N 个工作线程里并行裸奔——FPS 的游戏世界状态绝不能走这条路" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#8a6d1a;align=left;spacing=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="716" width="1380" height="32" as="geometry"/></mxCell>

        <mxCell id="z4" value="链4 · 定时器" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;fontColor=#5b3a70;verticalAlign=top;spacingTop=4;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="690" height="290" as="geometry"/></mxCell>
        <mxCell id="z4a" value="业务 → EventLoop::runEvery(ms, cb)　【event_loop.cpp:286】&#10;→ 时间轮 addTimer：slot 链表存 shared_ptr&lt;Timer&gt;&#10;　timer_map_[id] = weak_ptr(timer) ⚠️②　【HTW.h:99】&#10;　expiration_heap_ 补丁最小堆（前任自己救火痕迹）&#10;&#10;触发（双通道）：&#10;　├ timerfd 可读 → handleTimerfdRead　【event_loop.cpp:680】&#10;　└ loop 每 100ms 兜底 tick ⚠️⑥&#10;→ Wheel::tick()&#10;　├ advance(now)（跳 tick + 进位）&#10;　├ processExpiredTimers(0, now)　【HTW.cpp:152】&#10;　│　　到期 → submitAsyncTask(timer-&gt;callback)　:179&#10;　│　　　　　→ 回 loop 线程 doPendingFunctors 执行&#10;　└ 周期任务按原 expire_time+interval 重插（滞后追赶）&#10;⚠️② weak_ptr 链：map 持 weak / slot 持 shared——slot 被清则 map 全 expired" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="808" width="650" height="244" as="geometry"/></mxCell>

        <mxCell id="z6" value="链6 · 跨线程投递（唯一通道）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontStyle=1;fontColor=#333;verticalAlign=top;spacingTop=4;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="770" y="772" width="690" height="290" as="geometry"/></mxCell>
        <mxCell id="z6a" value="任意线程 → EventLoop::queueInLoop(cb)&#10;　→ pendingFunctors_.push + wakeup()&#10;　　（eventfd write 唤醒　【event_loop.cpp:37】）&#10;loop 线程 → epoll 醒来&#10;　→ doPendingFunctors()　【event_loop.cpp:811】&#10;　→ 逐个执行（swap 优化批量）&#10;&#10;位置：链4 的定时回调、链1 的 runInLoop(&#10;session-&gt;start) 都经此通道回 loop 线程&#10;—— 全库唯一合法跨线程路径，多线程&#10;演进时保留它即可" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="790" y="808" width="650" height="244" as="geometry"/></mxCell>

        <mxCell id="bottom" value="隐患登记（图内标位置，展开见第 13 期）：②时间轮 timer_map_ weak_ptr（链4）　③executeCallbackAsync 线程池分叉（链3）　⑤SIGPIPE 手写于各 main（链0）　⑥poll 100ms 轮询（链1/链4）&#10;验证方式：本图每个环节均标注源码文件:行号（MicroserviceDemo/include|src/common/），可逐行核对——零虚构" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=14;fontColor=#990000;align=left;spacing=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1082" width="1420" height="76" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
