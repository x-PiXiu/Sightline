<mxfile host="app.diagrams.net">
  <diagram name="毕设线程视图" id="threadlegacy">
    <mxGraphModel dx="1300" dy="900" grid="0" page="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="样张④ 线程视图 · 毕设网络库（组件住在哪个线程里，箭头 = 跨线程投递）" style="text;fontSize=24;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="36" as="geometry"/></mxCell>

        <mxCell id="t1" value="EventLoop 线程（1 个）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;fontColor=#1f6b30;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="520" height="420" as="geometry"/></mxCell>
        <mxCell id="c1" value="epoll_wait 循环" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="c2" value="Channel 分发" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="HTTP / WebSocket 解析" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="220" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="c4" value="HierarchicalTimingWheel&#10;⚠️ weak_ptr 存定时器" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="310" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="c5" value="Logger 单例" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="c6" value="listen_socket + conn fd 们" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="160" height="70" as="geometry"/></mxCell>

        <mxCell id="t2" value="通用 ThreadPool（N 个工作线程）" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;fontColor=#990000;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="520" height="420" as="geometry"/></mxCell>
        <mxCell id="w1" value="业务回调 A（请求 1）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="w2" value="业务回调 B（请求 2）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="200" height="55" as="geometry"/></mxCell>
        <mxCell id="w3" value="⚠️ 同时改「共享状态」——没有主线程，没有世界，只有一堆并行回调" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontColor=#990000;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="440" height="70" as="geometry"/></mxCell>
        <mxCell id="w4" value="⚠️ 回调里再调 Logger → 锁竞争" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b85450;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="840" y="340" width="440" height="50" as="geometry"/></mxCell>

        <mxCell id="cross" value="⚠️ 跨线程投递（无统一队列，直接丢）" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=3;dashed=1;fontSize=15;fontColor=#990000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="c3" target="w1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="cmp" value="对比锚点（新版线程视图预告）&#10;新版 = 1 个逻辑线程拥有「游戏世界」全部状态；&#10;IO 线程（演进项）只搬运字节，永远不碰世界状态；&#10;跨线程只有一条统一队列（queueInLoop）。&#10;——本图是「反面教材 v0」，新版图出来后对照着讲" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=16;fontColor=#990000;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="540" width="1240" height="140" as="geometry"/></mxCell>
        <mxCell id="note" value="线程视图读法（观众视角）：一个框 = 一个线程；框里的卡片 = 住在这个线程里的组件；&#10;跨框箭头 = 跨线程（危险动作——要加锁/队列）。适合讲「什么在哪跑、什么不许跨线程」。" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=15;fontColor=#333;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="1240" height="90" as="geometry"/></mxCell>
        <mxCell id="legend" value="色标：绿=EventLoop 线程　红=通用工作线程（隐患区）　黄=带隐患的组件" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontColor=#333;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="820" width="1240" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
