<mxfile host="app.diagrams.net">
  <diagram name="一个请求的旅程" id="journey">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1500" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="前任的网络库：一个请求的旅程（毕设原版 · 5 站 + 1 闹钟）" style="text;fontSize=25;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="38" as="geometry"/></mxCell>
        <mxCell id="hint" value="读法：跟着一个请求从左到右走——10 秒看懂主干，每站一句话" style="text;fontSize=15;fontColor=#888;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="900" height="26" as="geometry"/></mxCell>

        <mxCell id="client" value="客户端&#10;「点单的客人」" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="170" height="100" as="geometry"/></mxCell>

        <mxCell id="s1" value="① 迎宾&#10;「有人敲门，我去开」" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="220" height="260" as="geometry"/></mxCell>
        <mxCell id="s1b" value="听见敲门声就开门，&#10;看一眼来客名单——&#10;黑名单的直接请走。&#10;开门后给客人发个工牌，&#10;交给服务生。&#10;━━━━━&#10;工牌：Acceptor&#10;＋ 黑名单&#10;＋ 64 格储物柜" style="text;fontSize=14;fontColor=#555;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="285" y="200" width="210" height="190" as="geometry"/></mxCell>

        <mxCell id="s2" value="② 服务生&#10;「这桌归我管」" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="550" y="140" width="220" height="260" as="geometry"/></mxCell>
        <mxCell id="s2b" value="每位客人配一名服务生，&#10;从头跟到尾：收下菜单&#10;（字节先存托盘），&#10;攒够了才递给后厨。&#10;客人走了（读到 0）他收摊。&#10;━━━━━&#10;工牌：HttpSession&#10;＋ 托盘：缓冲区&#10;⚠️ 他只会听 HTTP 语" style="text;fontSize=14;fontColor=#555;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="555" y="200" width="210" height="190" as="geometry"/></mxCell>

        <mxCell id="s3" value="③ 后厨&#10;「听懂客人要什么」" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="220" height="260" as="geometry"/></mxCell>
        <mxCell id="s3b" value="把菜单翻译成订单，&#10;交给对应档口&#10;（用户/认证/数据部）。&#10;━━━━━&#10;工牌：路由分发&#10;HttpRequest → Handler" style="text;fontSize=14;fontColor=#555;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="825" y="200" width="210" height="190" as="geometry"/></mxCell>

        <mxCell id="s4" value="④ 出菜口&#10;「做好了的端回去」" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1090" y="140" width="200" height="260" as="geometry"/></mxCell>
        <mxCell id="s4b" value="订单完成 → 菜装盘&#10;→ 从原路端回客人桌上。&#10;━━━━━&#10;工牌：sendResponse&#10;＋ write(fd)" style="text;fontSize=14;fontColor=#555;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1095" y="200" width="190" height="190" as="geometry"/></mxCell>

        <mxCell id="e0" value="敲门" style="edgeStyle=none;strokeColor=#333333;strokeWidth=3;fontSize=14;fontColor=#333;background=#f7f4ee;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="发牌" style="edgeStyle=none;strokeColor=#0288d1;strokeWidth=3;fontSize=14;fontColor=#01579b;background=#f7f4ee;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="递菜单" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=3;fontSize=14;fontColor=#1f6b30;background=#f7f4ee;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="订单完成" style="edgeStyle=none;strokeColor=#d79b00;strokeWidth=3;fontSize=14;fontColor=#8a4b00;background=#f7f4ee;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="上菜 →" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;strokeWidth=3;fontSize=14;fontColor=#333;exitX=0.5;exitY=0;entryX=0.5;entryY=0;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="s4" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="100"/><mxPoint x="135" y="100"/></Array></mxGeometry></mxCell>

        <mxCell id="alarm" value="⏰ 闹钟岗位&#10;「到点的事我提醒」" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=8;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="450" y="470" width="640" height="170" as="geometry"/></mxCell>
        <mxCell id="alarm_b" value="心跳、超时、重连这类「到点要做的事」全归它管：每层转盘上挂着定时便签，指针走到就撕下来执行。&#10;━━━━━&#10;工牌：时间轮定时器　⚠️ 便签用「弱引用」贴的——撕的时候如果没抓稳，提醒会悄悄丢（这就是要换掉它的原因）&#10;它自己也被一只闹钟叫醒（timerfd），兜底则靠主循环每 100ms 看一眼 ⚠️" style="text;fontSize=14;fontColor=#555;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="460" y="520" width="620" height="110" as="geometry"/></mxCell>

        <mxCell id="kitchen" value="⚠️ 后厨的秘密（本次改造的根因）" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;fontColor=#990000;verticalAlign=top;spacingTop=6;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="450" y="670" width="640" height="130" as="geometry"/></mxCell>
        <mxCell id="kitchen_b" value="订单不是一位厨师做——被丢进「临时工池」谁有空谁做，多位厨师同时开工。&#10;做网页没事（各桌点的各做各的）；做游戏要命——游戏世界是一口锅，&#10;两个厨师同时颠同一口锅，这局游戏就不用玩了。&#10;━━━━━&#10;这就是我们第一刀切掉它、改成一厨一站的根本原因" style="text;fontSize=14;fontColor=#990000;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="460" y="710" width="620" height="84" as="geometry"/></mxCell>

        <mxCell id="concl" value="一句话：客人点单 → 迎宾开门 → 服务生跟桌 → 后厨加工 → 出菜回桌；闹钟管所有到点的事——而后厨的「临时工池」就是本次要动刀的地方。" style="text;fontSize=16;fontStyle=1;fontColor=#c8161d;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="810" width="1420" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
