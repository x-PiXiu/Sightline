<mxfile host="app.diagrams.net">
  <diagram name="网络库执行逻辑" id="loopcore2">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1520" pageHeight="1170" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="网络库怎么跑：一个循环 + 一张就绪名单（毕设 epoll 库 · 源码核实）" style="text;fontSize=24;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1150" height="38" as="geometry"/></mxCell>
        <mxCell id="hint" value="整个库只有一个线程。循环在右边，被循环叫号的三种角色在左边——每个角色本质上都是一个 Channel（fd + 回调）" style="text;fontSize=15;fontColor=#888;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="26" as="geometry"/></mxCell>

        <mxCell id="reg" value="前置：每个 fd 创建时，其 Channel 先注册进 epoll（events_.data.ptr 存 Channel*）&#10;【channel.h:24 Channel(loop, fd) → event_loop.cpp:448 updateChannel → epoll.cpp update/EPOLL_CTL_ADD】" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontColor=#555;align=left;spacing=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="96" width="1400" height="56" as="geometry"/></mxCell>

        <mxCell id="roles" value="三种角色 = 三类 Channel（都在 epoll 里挂号，就绪才上名单）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;fontColor=#1f6b30;verticalAlign=top;spacingTop=8;align=left;spacingLeft=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="660" height="680" as="geometry"/></mxCell>

        <mxCell id="r1" value="角色 A · 监听门铃（listen fd 的 Channel）&#10;就绪（EPOLLIN）= 有新客户端敲门&#10;干的事：accept 循环拿新 fd → 为每个新 fd&#10;创建「角色 B」并注册进 epoll → 从此归 B 管&#10;━━━━━&#10;回调注册：listen_channel_-&gt;setReadCallback&#10;　　　　　（handleNewConnection）【http_server.h:578】&#10;执行体：HttpServer::handleNewConnection&#10;　　　　　【http_server.cpp:645 · ≤100 次/轮防饿死 :649】" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="85" y="228" width="610" height="150" as="geometry"/></mxCell>

        <mxCell id="r2" value="角色 B · 连接（conn fd 的 Channel，每客户端一个）&#10;就绪（EPOLLIN）= 这个客户端发字节来了&#10;干的事：read 循环到 EAGAIN（ET 必须读干净）&#10;→ 字节攒进 input_buffer_ → 攒够一条完整请求&#10;→ 解析（毕设焊死了 HTTP 解析器 ⚠️ FPS 协议用不了）&#10;→ 解析成功：丢给帮手池处理（角色 D，出圈）&#10;━━━━━&#10;回调注册：channel_-&gt;setReadCallback(handleRead)&#10;　　　　　【http_session.cpp:53】&#10;执行体：HttpSession::handleRead【http_session.cpp:219】&#10;　　revents 判定：EPOLLHUP→close / EPOLLERR→error /&#10;　　EPOLLIN→read【channel.cpp:71-113 顺序实证】&#10;　　read 后 parseHttpRequest【:295】→&#10;　　executeCallbackAsync【:301-305 → 角色 D】" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="85" y="394" width="610" height="240" as="geometry"/></mxCell>

        <mxCell id="e_ab" value="A 就绪时会『造出』B 并注册" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#1f6b30;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="r3" value="角色 C · 闹钟（timerfd 的 Channel）&#10;就绪 = 定时任务到点（timerfd 可读）&#10;干的事：推动时间轮 tick → 到期任务出队，&#10;回调经 queueInLoop 排队，下一轮循环执行&#10;━━━━━&#10;执行体：handleTimerfdRead → wheel-&gt;tick()&#10;　　　　　【event_loop.cpp:680】&#10;⚠️ 任务表 timer_map_ 用 weak_ptr 存——&#10;　持有链断裂时提醒会静默丢失【HTW.h:99】&#10;⚠️ 另有 loop 兜底：poll 100ms 超时也会 tick 一次&#10;　（timerfd 坏了任务照样走，只是精度受损）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="85" y="680" width="610" height="165" as="geometry"/></mxCell>

        <mxCell id="loop" value="主循环（EventLoop::loop，唯一线程）" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;fontColor=#1f4e79;verticalAlign=top;spacingTop=8;align=left;spacingLeft=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="680" height="560" as="geometry"/></mxCell>

        <mxCell id="st1" value="① Epoll::poll(timeout=100ms)&#10;内核报告：哪些 fd 就绪了&#10;【event_loop.cpp:217 → epoll_wait】" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1060" y="228" width="380" height="70" as="geometry"/></mxCell>

        <mxCell id="st2" value="② fillActiveChannels：按 revents 填名单&#10;events_[i].data.ptr → Channel* → activeChannels_&#10;【epoll.cpp:222-231（revents 回填 channel）】" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1060" y="322" width="380" height="70" as="geometry"/></mxCell>

        <mxCell id="st3" value="③ 逐个叫号：channel-&gt;handleEvent()&#10;【event_loop.cpp:238（循环遍历 activeChannels_）】&#10;→ handleEvent 按 revents 触发该 fd 注册的回调&#10;　（EPOLLIN→readCallback …）【channel.cpp:71-113】&#10;→ 回调即左侧角色的执行体（A/B/C 各自干活）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1060" y="416" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="st4" value="④ 处理完本轮名单 → doPendingFunctors()&#10;（queueInLoop 投递的延迟任务在此统一执行&#10;　【event_loop.cpp:811】）&#10;→ 回到 ①" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1060" y="550" width="380" height="90" as="geometry"/></mxCell>

        <mxCell id="e_s1" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s2" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s3" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="st3" target="st4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s4" style="curved=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st4" target="st1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="595"/><mxPoint x="830" y="263"/></Array></mxGeometry></mxCell>
        <mxCell id="e_s4t" value="循环" style="text;fontSize=14;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="795" y="420" width="60" height="26" as="geometry"/></mxCell>

        <mxCell id="e_call" value="③ 叫号 → 角色回调执行" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c8161d;strokeWidth=3;fontSize=14;fontStyle=1;fontColor=#c8161d;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="st3" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e_ready" value="就绪 → 上名单" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;dashed=1;fontSize=13;fontColor=#1f6b30;exitX=1;exitY=0.4;entryX=0;entryY=0.5;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="r1" target="st1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="roleD" value="角色 D · 帮手池（线程池 ⚠️ 毕设的隐患③）&#10;角色 B 解析出完整请求后不自己处理：executeCallbackAsync →&#10;if(enable_thread_pool) thread_pool_-&gt;submit(cb)  ← N 个帮手并行干活&#10;else cb()（没池就循环线程自己干）【event_loop.cpp:1474-1490】&#10;网页没事（每桌各做各的）；游戏要命——世界状态是一口锅，多帮手同时颠必炸&#10;═══ 我们的处置：第一刀就切掉帮手池，处理回到循环线程排队做（帧队列的前身）" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontColor=#990000;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="900" height="130" as="geometry"/></mxCell>

        <mxCell id="qil" value="queueInLoop 快递通道（全库唯一合法跨线程路径）&#10;任何线程想把活交回循环线程：投 pendingFunctors_ +&#10;写 eventfd 唤醒 → 循环在 ④ 统一执行【event_loop.cpp:283/811】&#10;角色 C 的到期回调、角色 A 的 runInLoop(session-&gt;start) 都走这条" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontColor=#555;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="990" y="880" width="470" height="130" as="geometry"/></mxCell>

        <mxCell id="concl" value="一句话：所有 fd 先在 epoll 挂号 → 循环每轮问内核要就绪名单 → 逐个叫号触发各自回调——门铃造连接、连接攒字节解析、闹钟推时间轮；这就是毕设网络库的全部执行逻辑。" style="text;fontSize=15;fontStyle=1;fontColor=#c8161d;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1430" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
