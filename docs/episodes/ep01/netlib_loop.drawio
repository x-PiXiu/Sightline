<mxfile host="app.diagrams.net">
  <diagram name="网络库执行逻辑" id="loopcore">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="网络库怎么跑：一个循环 + 一张就绪名单（毕设原版机制）" style="text;fontSize=25;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="38" as="geometry"/></mxCell>
        <mxCell id="hint" value="整个库只有一个线程在跑；下面的一切都发生在这个循环里" style="text;fontSize=15;fontColor=#888;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="900" height="26" as="geometry"/></mxCell>

        <mxCell id="kernel" value="内核（记录每个 fd 的状态）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;fontStyle=1;fontColor=#555;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="380" height="50" as="geometry"/></mxCell>

        <mxCell id="ask" value="① 问：谁就绪了？&#10;epoll_wait（最多等 100ms ⚠️）&#10;【event_loop.cpp:202】" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="e_k" value="把就绪的 fd 报给我" style="edgeStyle=none;strokeColor=#999999;strokeWidth=2;fontSize=13;fontColor=#555;background=#f7f4ee;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ask" target="kernel"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="list" value="② 就绪名单（activeChannels_）&#10;本轮醒着的 fd：可能是监听门铃 / 某条连接 / 闹钟" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="e_a" style="edgeStyle=none;strokeColor=#6c8ebf;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ask" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="call" value="③ 逐个叫号：fd-&gt;handleEvent()&#10;每个 fd 注册过「就绪时该干什么」（回调）" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="760" y="410" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="e_l" style="edgeStyle=none;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="list" target="call"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="back" value="④ 处理完这一轮，回到 ①" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="140" height="180" as="geometry"/></mxCell>
        <mxCell id="e_back" style="curved=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="call" target="ask"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="230"/></Array></mxGeometry></mxCell>

        <mxCell id="roles" value="名单上会出现的三种角色（每个都注册了自己的回调）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;fontColor=#1f6b30;verticalAlign=top;spacingTop=8;align=left;spacingLeft=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="640" height="480" as="geometry"/></mxCell>

        <mxCell id="r1" value="角色 A · 监听门铃（listen fd）&#10;就绪 = 有新客户端敲门&#10;干的事：accept 拿到新 fd →&#10;造一个「角色 B」挂进循环 →&#10;以后这个新 fd 的事都归角色 B 管&#10;━━━━━&#10;回调：HttpServer::handleNewConnection&#10;【http_server.cpp:645】" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="85" y="240" width="590" height="130" as="geometry"/></mxCell>

        <mxCell id="r2" value="角色 B · 连接（conn fd，每个客户端一个）&#10;就绪 = 这个客户端发字节来了&#10;干的事：循环 read 到读干净（ET 模式必须）→&#10;字节攒进自己的缓冲区 → 攒够一条完整请求 →&#10;解析（毕设这里焊死了 HTTP 解析 ⚠️）→&#10;解析成功就「叫个帮手」处理（见角色 D）&#10;━━━━━&#10;回调：HttpSession::handleRead&#10;【http_session.cpp:219】" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="85" y="386" width="590" height="150" as="geometry"/></mxCell>

        <mxCell id="r3" value="角色 C · 闹钟（timerfd）&#10;就绪 = 有定时任务到点了&#10;干的事：推动时间轮走一格 →&#10;到期的任务被拿出执行（回调先排队，下一轮循环跑）&#10;━━━━━&#10;回调：handleTimerfdRead → 时间轮 tick&#10;【event_loop.cpp:680】⚠️ 任务表用弱引用存，会丢" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="85" y="552" width="590" height="105" as="geometry"/></mxCell>

        <mxCell id="e_r1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="r1" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_r2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r2" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_r3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="r3" target="list"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="roleD" value="角色 D · 帮手池（⚠️ 毕设的问题 child）&#10;角色 B 解析出请求后，不自己处理——丢给「线程池」谁空谁干：&#10;网页没事（每桌各做各的）；游戏不行（世界是一口锅，多人同时颠会炸）&#10;━━━━━&#10;executeCallbackAsync → thread_pool_-&gt;submit　【event_loop.cpp:1474】&#10;我们第一刀切的就是它：帮手池撤了，改回「一厨一站」——所有处理回到循环线程排队做" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=0;fontColor=#990000;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="860" height="120" as="geometry"/></mxCell>

        <mxCell id="wakeup" value="另有一条内部快递通道（queueInLoop）：任何线程想把活&#10;交回循环线程，就投进队列 + 敲一下 eventfd——循环下一轮&#10;顺手把队列里的活全干了。全库唯一合法跨线程路径。&#10;【event_loop.cpp:811 doPendingFunctors】" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontColor=#555;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="500" height="120" as="geometry"/></mxCell>

        <mxCell id="concl" value="一句话：单线程循环问内核要就绪名单 → 逐个叫号；门铃造连接、连接攒字节、闹钟推时间——这就是这个网络库的全部执行逻辑。" style="text;fontSize=16;fontStyle=1;fontColor=#c8161d;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="860" width="1420" height="36" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
