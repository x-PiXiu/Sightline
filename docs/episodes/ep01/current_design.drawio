        <mxCell id="miss" value="缺失：Acceptor · TcpConnection · Buffer（无 TCP 连接抽象，上层靠 WebSocket）⚠️①&#10;SIGPIPE：网络库不管，靠每个 main 记得手写 ⚠️⑤" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontColor=#990000;dashed=1;" vertex="1" parent="1"><mxGeometry x="90" y="640" width="790" height="90" as="geometry"/></mxCell>
