<mxfile host="app.diagrams.net">
  <diagram name="现状设计" id="cur1">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="前任的网络库 · 现状设计（毕设原版）" style="text;fontSize=26;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="18" width="800" height="40" as="geometry"/></mxCell>

        <mxCell id="fps" value="UE 客户端想要：TCP 长连接 + 自定义二进制协议 [2B len][2B msgid]" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="75" width="940" height="56" as="geometry"/></mxCell>

        <mxCell id="arr_block" value="现在连不上" style="edgeStyle=none;strokeColor=#b85450;strokeWidth=3;fontSize=15;fontColor=#990000;dashed=1;verticalAlign=middle;labelBackgroundColor=#f7f4ee;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fps" target="wall"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="wall" value="缺失三件套：Acceptor（接客） · TcpConnection（连接生命周期） · Buffer（收发缓冲）　→ 第 1 期补齐" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;fontColor=#990000;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="230" y="180" width="1140" height="62" as="geometry"/></mxCell>

        <mxCell id="arr_ok" value="补齐后即可到达" style="edgeStyle=none;strokeColor=#82b366;strokeWidth=3;fontSize=15;fontColor=#1f6b30;labelBackgroundColor=#f7f4ee;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wall" target="base"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="base" value="自研 epoll 网络底座 —— ✅ 第 1 期直接用" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;fontStyle=1;fontColor=#1f6b30;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="1060" height="380" as="geometry"/></mxCell>
        <mxCell id="loop" value="EventLoop&#10;（单事件循环）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="100" y="350" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="ch" value="Channel" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="430" y="350" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="ep" value="Epoll" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="640" y="350" width="130" height="70" as="geometry"/></mxCell>
        <mxCell id="sock" value="Socket&#10;bind / listen / accept" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="830" y="350" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="loop" target="ch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ch" target="ep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="tw" value="HierarchicalTimingWheel&#10;层级时间轮　⚠️ weak_ptr 存定时器" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="100" y="510" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="lg" value="Logger 单例　⚠️ 耦合配置/线程池" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="560" y="510" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="e3" value="runEvery（心跳计时直接用）" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontColor=#1f6b30;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="loop" target="tw"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="ext" value="外部依赖&#10;ConfigManager · 通用 ThreadPool" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1180" y="290" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="web" value="为 Web 而生 —— FPS 用不上&#10;HTTP Server · WebSocket Server" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1180" y="440" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="e4" value="⚠️ 回调丢业务线程池并行跑" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;dashed=1;strokeWidth=2;fontSize=14;fontColor=#990000;exitX=1;exitY=0.25;entryX=0;entryY=0.5;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="loop" target="ext"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="挂在底座上" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontColor=#8a6d1a;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#f7f4ee;" edge="1" parent="1" source="web" target="base"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="risks" value="交接批注 · 六条隐患（细节第 13 期事故复盘见，图随每期演化）&#10;① 无 TCP 连接抽象，上层直接是 Web　② 时间轮 weak_ptr 存定时器　③ 回调丢通用线程池，游戏状态并行风险&#10;④ 网络层耦合 ConfigManager / ThreadPool　⑤ SIGPIPE 靠每个 main 手写　⑥ epoll 100ms 轮询，无 timerfd 精准唤醒" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontColor=#990000;align=left;spacing=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="1130" height="160" as="geometry"/></mxCell>

        <mxCell id="legend" value="图例（全系列统一）&#10;绿 = 可直接用的底座&#10;黄 = FPS 用不上&#10;红 = 隐患 / 缺失&#10;灰 = 外部依赖" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=15;fontColor=#333333;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="720" width="310" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
