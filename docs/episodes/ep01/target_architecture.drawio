<mxfile host="app.diagrams.net">
  <diagram name="目标架构v2" id="targetarch2">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1560" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Sightline 服务端 · 目标架构 v2.0（第 1 期实施版 · 四层 · 依赖向内 · 单线程起步）" style="text;fontSize=25;fontStyle=1;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="38" as="geometry"/></mxCell>
        <mxCell id="ver" value="v2.0 · 相对 v1.0（现状架构图）：🆕 新增三件套 + FrameCodec + 帧队列——红墙补齐" style="text;fontSize=16;fontStyle=1;fontColor=#0288d1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="900" height="30" as="geometry"/></mxCell>

        <mxCell id="mainbox" value="main.cpp —— 组装根：日志装配(addSink) · SIGPIPE · EventLoop · Acceptor · 消息分发注册（最脏的一层，只干装配）" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="92" width="1000" height="50" as="geometry"/></mxCell>

        <mxCell id="adplayer" value="adapters 层 —— 翻译（字节 ↔ 消息 ↔ 调用）【🆕 第 1 期新增】" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=18;fontStyle=1;fontColor=#01579b;verticalAlign=top;spacingTop=6;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="110" y="162" width="1000" height="120" as="geometry"/></mxCell>
        <mxCell id="ad1" value="FrameCodec 🆕&#10;[2B len][2B msgid] 切帧（半包等待）" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="135" y="208" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="ad2" value="MessageDispatcher 🆕&#10;按 msgid 分发 · 限频钩子挂点" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="455" y="208" width="290" height="60" as="geometry"/></mxCell>
        <mxCell id="ad3" value="ClientRegistry 🆕（第 2 期）&#10;clientId ↔ 连接映射" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#0288d1;fontSize=15;dashed=1;" vertex="1" parent="1"><mxGeometry x="775" y="208" width="310" height="60" as="geometry"/></mxCell>

        <mxCell id="netlayer" value="net 层 —— 网络机制（毕设底座 + 补齐）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;fontColor=#1f6b30;verticalAlign=top;spacingTop=6;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="110" y="302" width="1000" height="240" as="geometry"/></mxCell>
        <mxCell id="n1" value="Acceptor 🆕&#10;bind/listen → accept 循环" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="135" y="348" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="n2" value="ClientConnection 🆕&#10;生命周期 · shared_from_this" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="375" y="348" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="n3" value="RecvBuffer / SendBuffer 🆕" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="615" y="348" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="n4" value="EventLoop ✅复用&#10;tick 同步 · queueInLoop" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="855" y="348" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="n5" value="Channel / Epoll ✅ · Socket ✅ · InetAddress ✅ · HierarchicalTimingWheel ⚠️(演进②) · Logger ⚠️(装配)" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="135" y="430" width="950" height="46" as="geometry"/></mxCell>
        <mxCell id="n8" value="演进项：timerfd+堆定时器 · 多 IO 线程 · 日志异步化（第 12 期压测后决策）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="135" y="484" width="950" height="44" as="geometry"/></mxCell>

        <mxCell id="loopbox" value="服务器主线程（第 1 期单线程）&#10;├ 帧队列（🆕 std::deque：切好的帧入队）&#10;├ 33ms 帧：取帧 → MessageDispatcher 分发 → 心跳 echo&#10;└ queueInLoop / eventfd 唤醒（唯一跨线程点·演进保留）" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontColor=#8a4b00;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="162" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="thread" value="线程模型容量论证&#10;16 人 × 几十条/秒 ≈ 千级消息/秒&#10;vs 单线程十万级/秒能力——余量百倍&#10;先正确后并行（多 IO 线程=演进项）" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#c8161d;fontSize=15;fontColor=#333;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="362" width="360" height="140" as="geometry"/></mxCell>

        <mxCell id="applayer" value="application 层 —— 用例【第 2 期起填充】端口签名全业务语言" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontStyle=1;fontColor=#8a4b00;verticalAlign=top;spacingTop=6;align=left;spacingLeft=16;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="566" width="1000" height="120" as="geometry"/></mxCell>
        <mxCell id="ap1" value="能力端口（出）&#10;sendToClient(clientId, bytes)&#10;schedule(ms, cb) / cancel" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="135" y="608" width="420" height="66" as="geometry"/></mxCell>
        <mxCell id="ap2" value="事件入口（进）—— 由 adapters 调用&#10;onClientConnected / onFrameMessage(clientId, msgid, payload)" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="590" y="608" width="500" height="66" as="geometry"/></mxCell>

        <mxCell id="domainlayer" value="domain 层 —— 纯规则，零 IO 零框架（脱离一切可单测）【第 2 期起填充】Room 状态机 · Player · hitscan" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontSize=17;fontStyle=1;verticalAlign=middle;dashed=1;align=left;spacingLeft=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="110" y="716" width="1000" height="60" as="geometry"/></mxCell>

        <mxCell id="deparrow" value="" style="edgeStyle=none;strokeColor=#c8161d;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="170" as="sourcePoint"/><mxPoint x="70" y="830" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="deptext" value="依赖方向：外 → 内（铁律）&#10;net 不认识业务&#10;application 不认识 socket&#10;domain 不认识任何人" style="text;fontSize=15;fontStyle=1;fontColor=#c8161d;align=center;verticalAlign=middle;rotation=-90;" vertex="1" parent="1"><mxGeometry x="-115" y="455" width="330" height="50" as="geometry"/></mxCell>

        <mxCell id="legend" value="图例（全系列统一）　绿 = 复用毕设底座　蓝 = 第 1 期新增　黄虚线 = 演进项（按需触发）　灰/橙虚线 = 装配与后期层&#10;端口审计标准：application 头文件出现任何技术名词（fd/socket/epoll）= 依赖倒置名存实亡　|　铁律：定稿图 = 派活依据，代码与图不一致 = 代码错" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontColor=#333;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1500" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
