        <mxCell id="mss1" value="+ HandleFrame(15/17/18/21)（GI 白名单转发）&#10;+ ReportLocalState（30Hz·19 号）/ SendFireRequest（20 号）&#10;+ StartMatch（14 号）/ ReconcileSelf（ε 回滚/断档全量）&#10;+ GetServerAuthPos / GetRegistry【ep06 幽灵源】&#10;+ OnMatchStarted / OnSelfCorrected / OnFireResult : 委托" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_mss"><mxGeometry x="4" y="40" width="392" height="112" as="geometry"/></mxCell>
