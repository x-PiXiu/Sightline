        <mxCell id="lob1" value="− playersByFd_ : map&lt;fd, Player&gt;&#10;− fdByName_ : map&lt;name, fd&gt;&#10;− roomByFd_ : map&lt;fd, roomId&gt;&#10;− graceByFd_ : map&lt;fd, 接入时刻&gt;&#10;− rooms_ : map&lt;roomId, Room&gt;&#10;− nextPlayerId_ / nextRoomId_" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_lob"><mxGeometry x="4" y="40" width="412" height="128" as="geometry"/></mxCell>
