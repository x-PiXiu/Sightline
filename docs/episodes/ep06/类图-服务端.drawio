        <mxCell id="lob1" value="− playersByFd_ : map&lt;fd, Player&gt;&#10;− fdByName_ : map&lt;string, fd&gt;&#10;− roomByFd_ : map&lt;fd, roomId&gt;&#10;− rooms_ : map&lt;roomId, Room&gt;&#10;− nextPlayerId_ : uint32" style="text;fontSize=13;align=left;whiteSpace=wrap;verticalAlign=top;spacingLeft=8;" vertex="1" parent="c_lob"><mxGeometry x="4" y="38" width="422" height="96" as="geometry"/></mxCell>
        <mxCell id="lob2" value="+ Login(fd, name) : Event[]&#10;+ CreateRoom / Join / Leave / Disconnect&#10;+ RoomRoster(roomId) : RoomMemberInfo[]&#10;+ IsHost(fd) / RoomIdByFd(fd) / PlayerIdByFd(fd)&#10;+ RoomMemberFds(roomId) : vector&lt;int&gt;" style="text;fontSize=13;align=left;whiteSpace=wrap;verticalAlign=top;spacingLeft=8;" vertex="1" parent="c_lob"><mxGeometry x="4" y="136" width="422" height="140" as="geometry"/></mxCell>

