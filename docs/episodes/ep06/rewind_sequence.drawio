<mxfile host="app.diagrams.net">
  <diagram name="回溯时序图" id="rewind_seq">
    <mxGraphModel dx="1500" dy="900" grid="0" page="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell>
        <mxCell id="title" value="回溯时序——判定时刻 = now − rtt（单钟 ADR-1）" style="text;fontSize=38;fontStyle=1;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="36" width="1300" height="60" as="geometry"/></mxCell>
        <mxCell id="stamp" value="回溯时序图 · 入镜主图 · 草案 v1 · 2026-11-01" style="text;fontSize=18;fontColor=#999999;align=right;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1350" y="50" width="500" height="34" as="geometry"/></mxCell>

        <mxCell id="lg1" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1180" y="96" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="lg1t" value="客户端" style="text;fontSize=16;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1212" y="94" width="100" height="30" as="geometry"/></mxCell>
        <mxCell id="lg2" value="" style="rounded=1;fillColor=#e1f5fe;strokeColor=#0288d1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1330" y="96" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="lg2t" value="服务器" style="text;fontSize=16;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1362" y="94" width="100" height="30" as="geometry"/></mxCell>
        <mxCell id="lg3" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1480" y="96" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="lg3t" value="红虚线 = 钳制/防御路径" style="text;fontSize=16;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1512" y="94" width="260" height="30" as="geometry"/></mxCell>
        <mxCell id="lg4" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1790" y="96" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="lg4t" value="绿 = ep06 新增" style="text;fontSize=16;fontColor=#333333;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1822" y="94" width="160" height="30" as="geometry"/></mxCell>

        <mxCell id="cliHead" value="UE 客户端 · 射手" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=24;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="srvHead" value="服务器 · 裁决方（match_wiring 收帧 → MatchService.Fire）" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=24;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="700" height="56" as="geometry"/></mxCell>
        <mxCell id="cliLife" style="endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="206" as="sourcePoint"/><mxPoint x="520" y="1010" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="srvLife" style="endArrow=none;dashed=1;strokeColor=#0288d1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="206" as="sourcePoint"/><mxPoint x="1470" y="1010" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="step1" value="① 心跳 2 号→ACK 3 号（1Hz）&#10;同钟直减：rtt = 收到时刻 − 发出时刻" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="90" y="240" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.3;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1" source="step1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="275" as="sourcePoint"/><mxPoint x="1470" y="262" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.7;entryX=1;entryY=0.55;sketch=1;curveFitting=1;jiggle=2;dashed=1;" edge="1" parent="1" source="srvHead"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="290" as="sourcePoint"/><mxPoint x="470" y="292" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="step2" value="② 22 号上报（6B·1Hz）：rtt + ↑↓流量（客户端测、客户端报）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="380" height="56" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.4;fontSize=16;sketch=1;curveFitting=1;jiggle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="step2"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="388" as="sourcePoint"/><mxPoint x="1470" y="380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="step3" value="③ Entity.shooterRtt = rtt（存储·ep06）" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1560" y="452" width="420" height="50" as="geometry"/></mxCell>

        <mxCell id="step4" value="④ 19 号 30Hz（权威位推算·上行 U≈0）&#10;→ 历史环 push (接收时刻, 权威位)&#10;32 槽 ≈ 1.07s 窗口" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1560" y="530" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.4;entryX=1;entryY=0.3;fontSize=16;sketch=1;curveFitting=1;jiggle=2;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="566" as="sourcePoint"/><mxPoint x="520" y="560" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="step5" value="⑤ 屏幕所见 = 最新快照内容 = P(now − D)&#10;D = 下行延迟（滑块注入）——所见即「过去」" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="90" y="520" width="440" height="80" as="geometry"/></mxCell>

        <mxCell id="step6" value="⑥ 20 号开火（空 payload·T_key）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="90" y="660" width="380" height="50" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.35;sketch=1;curveFitting=1;jiggle=2;strokeWidth=2;" edge="1" parent="1" source="step6"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="685" as="sourcePoint"/><mxPoint x="1470" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="step7" value="⑦ judgeAt = now − min(rtt, 1000)   ← 恒等式：judgeAt ≡ T_key − D&#10;　 = 所见快照的「拍摄时刻」（判定回溯到射手看到的瞬间）" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=19;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1120" y="742" width="760" height="76" as="geometry"/></mxCell>
        <mxCell id="step8" value="⑧ 历史环插值采样 → 遮挡/胶囊求交 → 扣血 → 21 号广播（22B·含 victimHp）" style="rounded=1;whiteSpace=wrap;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1120" y="840" width="760" height="50" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=16;sketch=1;curveFitting=1;jiggle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="925" as="sourcePoint"/><mxPoint x="520" y="925" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="step9" value="⑨ Hitmarker / 弹孔 / 幽灵绿球（命中标记）" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="90" y="900" width="420" height="50" as="geometry"/></mxCell>

        <mxCell id="clamp" value="rtt &gt; 1000 → 钳制（kMaxRewindMs·伪造高 RTT 防御，ep09 预埋）" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;dashed=1;dashPattern=8 4;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1560" y="345" width="420" height="46" as="geometry"/></mxCell>

        <mxCell id="note" value="恒等式（TCP 同流）：judgeAt ≡ T_key + U − rtt ≡ T_key − D&#10;——判定时刻天然对齐「所见快照的拍摄时刻」，与上下行如何分摊无关" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=18;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="700" y="240" width="470" height="86" as="geometry"/></mxCell>
        <mxCell id="note2" value="历史环 = 每实体 32 槽环形&#10;(接收时刻, 钳后权威位)&#10;回溯只换判定时刻，管线不动" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=17;sketch=1;curveFitting=1;jiggle=2;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="700" y="520" width="470" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
