        <mxCell id="arrow2" value="" style="endArrow=block;html=1;strokeColor=#555555;strokeWidth=2.5;sketch=1;curveFitting=1;jiggle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="seg2" target="seg3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arrow3" value="" style="endArrow=block;html=1;strokeColor=#555555;strokeWidth=2.5;sketch=1;curveFitting=1;jiggle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="seg3" target="seg4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="arrow4" value="" style="endArrow=block;html=1;strokeColor=#555555;strokeWidth=2.5;sketch=1;curveFitting=1;jiggle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="seg4" target="dst"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="evline" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656;strokeWidth=2.5;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="322" as="sourcePoint"/><mxPoint x="1022" y="322" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="evlbl" value="②③④ 段的治理手段 —— 演进预留" style="text;fontSize=15;fontStyle=1;fontColor=#7f6000;align=center;sketch=1;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="340" height="20" as="geometry"/></mxCell>

        <mxCell id="keyline" value="传播是物理极限，治不了；工程能做的，是把延迟重新分配到玩家不敏感的位置 —— 滑块加的 150ms，就是这四段的总和" style="rounded=1;whiteSpace=wrap;fillColor=#f8fbff;strokeColor=#6c8ebf;strokeWidth=2.5;fontSize=16;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="396" width="1080" height="56" as="geometry"/></mxCell>

        <mxCell id="legend" value="灰 = 外部约束（不可动）　蓝 = 本期损伤滑块作用面　黄 = 演进预留　绿 = 现有底座　|　量级为通用典型值，实测以 KPI 曲线为准" style="text;fontSize=13;fontColor=#555555;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1120" height="24" as="geometry"/></mxCell>
