        <mxCell id="pit" value="坑（本期实测返工）：挂载原来写在 BeginPlay —— Pawn 先 Spawn、后才 Possess，那一刻 Controller 还是空，挂载被跳过，输入映射从未生效。修 = 挪进 SetupPlayerInputComponent（Possess 建输入组件时必调，Controller 必在）" style="rounded=1;whiteSpace=wrap;fillColor=#f8f0f0;strokeColor=#c8161d;strokeWidth=2;align=left;spacing=8;fontSize=14;fontStyle=1;fontColor=#c8161d;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="1080" height="64" as="geometry"/></mxCell>
        <mxCell id="pitline" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#c8161d;strokeWidth=2;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="240" as="sourcePoint"/><mxPoint x="632" y="292" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="keyline" value="为什么速度=位移差分：远端是直接摆位置，引擎速度恒为零 —— 表现层不许自己猜，谁驱动的状态谁提供数据（动画走的 FAnimInputs 同一个采集点）" style="rounded=1;whiteSpace=wrap;fillColor=#f8fbff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="60" y="396" width="1080" height="52" as="geometry"/></mxCell>

        <mxCell id="evolve" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656;strokeWidth=2.5;sketch=1;curveFitting=1;jiggle=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="486" as="sourcePoint"/><mxPoint x="1140" y="486" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="evolvelbl" value="本地先行（客户端预测）与输入历史缓冲 —— 演进预留" style="text;fontSize=15;fontStyle=1;fontColor=#7f6000;align=center;sketch=1;" vertex="1" parent="1"><mxGeometry x="400" y="494" width="420" height="20" as="geometry"/></mxCell>

        <mxCell id="legend" value="绿 = 复用底座（第 1 期连接）　蓝 = 第 3 期新增　红 = 实测踩坑标注　灰 = 外部　黄虚线 = 演进预留　|　图 = 代码一致" style="text;fontSize=13;fontColor=#555555;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="1120" height="24" as="geometry"/></mxCell>
