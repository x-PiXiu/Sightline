        <mxCell id="title" value="输入链路 —— 从按键到字节，每一跳都有名字" style="text;fontSize=22;fontStyle=1;fontColor=#333333;align=left;sketch=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1100" height="32" as="geometry"/></mxCell>

