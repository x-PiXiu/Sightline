        <mxCell id="e1" value="START_MATCH&#10;房主·名册过桥" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sLobby" target="sAlive"><mxGeometry relative="1" as="geometry"/></mxCell>
