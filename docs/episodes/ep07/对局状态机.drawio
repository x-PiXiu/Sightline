        <mxCell id="e8" value="清场·回大厅" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="sClose" target="sLobby"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="死亡期开火 ✘&#10;gate=4 回传" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=15;fontColor=#990000;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="sDead" target="sReject"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="illegal" value="非法操作 · 服务器处置&#10;─────────────────&#10;死亡期开火 → 拒·gate=4 回传&#10;无敌期被击杀 → 不扣血·[无敌]旗&#10;终局后开火 → 终局门拒绝&#10;未在局开火 → 门①丢弃" style="rounded=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cccccc;fontSize=15;align=left;spacing=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例&#10;■ 绿 既有主干　■ 蓝 本期新增&#10;□ 灰 对局外　■ 红 非法/拒绝&#10;蓝实线 = 重生环（本期核心）&#10;灰实线 = 合法转移　红虚线 = 非法路径" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;fontSize=15;align=left;spacing=12;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="1230" y="640" width="330" height="170" as="geometry"/></mxCell>
        <mxCell id="concl" value="结论：死亡不是结束——3 秒倒计时、选点排占位、2 秒无敌、开火即破，重生也是服务器权威的一部分。" style="rounded=1;whiteSpace=wrap;fillColor=#f7f4ee;strokeColor=#b85450;fontSize=16;fontStyle=1;align=left;spacing=14;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="80" y="1070" width="1440" height="80" as="geometry"/></mxCell>
