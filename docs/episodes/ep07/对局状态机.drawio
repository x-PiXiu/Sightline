        <mxCell id="e3" value="3s 到期重生&#10;24 号·权威落位&#10;选点排占位 150cm" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#0288d1;strokeWidth=3;fontSize=15;labelBackgroundColor=#ffffff;sketch=1;curveFitting=1;jiggle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sDead" target="sInvuln"><mxGeometry relative="1" as="geometry"/></mxCell>
