        <mxCell id="subtitle" value="生命周期与重生环全部由服务器裁决（图=代码：MatchService）" style="text;html=1;fontSize=15;fontColor=#999999;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="58" width="1100" height="24" as="geometry"/></mxCell>

        <mxCell id="sLobby" value="未在局" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=19;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="sAlive" value="存活" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=26;fontStyle=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1"><mxGeometry x="520" y="370" width="230" height="130" as="geometry"/></mxCell>
