        <!-- ═══ 大厅用例 ═══ -->
        <mxCell id="c_lob" value="LobbyService" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="420" height="400" as="geometry"/></mxCell>
        <mxCell id="lob1" value="− playersByFd_ : map&lt;fd, Player&gt;&#10;− fdByName_ : map&lt;name, fd&gt;&#10;− roomByFd_ : map&lt;fd, roomId&gt;&#10;− graceByFd_ : map&lt;fd, 接入时刻&gt;&#10;− rooms_ : map&lt;roomId, Room&gt;&#10;− bots_ : vector&lt;BotInfo&gt;【ep07】&#10;− roomInMatch_ : map&lt;roomId, bool&gt;【ep07】&#10;− nextPlayerId_ / nextRoomId_" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_lob"><mxGeometry x="4" y="40" width="412" height="172" as="geometry"/></mxCell>
        <mxCell id="lob2" value="+ Login / CreateRoom / Join / Leave&#10;+ Disconnect / SweepLoginTimeouts(now)&#10;+ ShutdownBroadcast（D3-19 优雅关闭）&#10;+ RoomRoster(roomId)（尾部并人机）【ep07】&#10;+ AddBot / RemoveBot / IsBot【ep07】&#10;+ SetRoomInMatch / RoomInMatch【ep07】&#10;　（对局中拒 JOIN·原因码 5）&#10;+ IsHost / RoomIdByFd / PlayerIdByFd&#10;+ LobbySubscribers / RoomMemberFds" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_lob"><mxGeometry x="4" y="216" width="412" height="176" as="geometry"/></mxCell>

        <mxCell id="c_room" value="Room" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="room1" value="+ roomId : uint32&#10;+ name : string&#10;+ memberFds : vector&lt;fd&gt;&#10;　（首位=现任房主）&#10;+ full() / empty()" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_room"><mxGeometry x="4" y="40" width="192" height="112" as="geometry"/></mxCell>

        <mxCell id="c_player" value="Player" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="190" height="120" as="geometry"/></mxCell>
