        <mxCell id="c_wire" value="«adapter» MatchWiring" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;dashed=1;fillColor=#e1f5fe;strokeColor=#0288d1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="wire1" value="+ MatchWiring(disp, match, lobby, writer, bot*)&#10;− 14 号：查 RoomRoster → RosterEntry[] → StartMatch&#10;　（fd↔PlayerId 翻译在此·两用例互不认识）&#10;− 26/27 号：人机席位指令（仅房主）【ep07】&#10;　→ lobby.AddBot/RemoveBot + bot_.OnBotAdded" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_wire"><mxGeometry x="4" y="40" width="412" height="122" as="geometry"/></mxCell>
        <mxCell id="wireNote" value="适配层对照锚点——非业务层，画入仅示 D3-15 过桥（Lobby ⊥ Match 互不 include）" style="text;html=1;fontSize=13;fontColor=#888888;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1014" width="470" height="20" as="geometry"/></mxCell>

        <!-- ═══ 对局用例 ═══ -->
        <mxCell id="c_roster" value="«struct» RosterEntry" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="roster1" value="+ playerId : uint32&#10;+ name : string&#10;+ spawnIndex : uint8（=出生点序）" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_roster"><mxGeometry x="4" y="40" width="242" height="70" as="geometry"/></mxCell>

        <mxCell id="c_ms" value="MatchService" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="390" width="440" height="360" as="geometry"/></mxCell>
        <mxCell id="ms1" value="− entities_ : vector&lt;Entity&gt;&#10;− roomId_ : uint32 · bActive_ : bool&#10;− geometry_ : MapGeometry（构建期注入）&#10;− bEnded_ / endReason_ / snapshotStopAtMs【ep07】" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_ms"><mxGeometry x="4" y="40" width="432" height="92" as="geometry"/></mxCell>
        <mxCell id="ms2" value="+ StartMatch(roomId, roster[]) : MatchEvent[]&#10;+ UpdateEntity(…, recvMs)　权威推算+钳制+历史环【ep06】&#10;+ SetShooterRtt(pid, rttMs)【ep06】&#10;+ Fire(pid, nowMs)：judgeAt = now − min(rtt, 1000)【ep06】&#10;+ Tick(nowMs)：快照+死亡倒计时+重生+终局判定【ep07】&#10;+ AbortMatch()（最后真人离开·❗12）【ep07】&#10;+ Entities() / Geometry() / IsEnded() / EntityById()【ep07 只读】&#10;+ SetGeometry(g) / RemovePlayer / IsActive" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_ms"><mxGeometry x="4" y="136" width="432" height="216" as="geometry"/></mxCell>

        <mxCell id="c_ent" value="Entity" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="840" width="300" height="280" as="geometry"/></mxCell>
        <mxCell id="ent1" value="+ playerId : uint32&#10;+ x,y,z 权威位 / yaw,pitch&#10;+ flags / ackedSeq / bHasReport&#10;+ lx,ly,lz 增量基准 · weapon : WeaponState&#10;+ history[32] / histCount / histHead【ep06】&#10;+ shooterRtt : uint16 / lastRecvMs【ep06】&#10;+ bDead / respawnAtMs / invulnUntilMs【ep07】&#10;+ bornAtMs / rebasePending / spawnIx【ep07】&#10;+ spawnX,Y,Z 落点锚 / kills / deaths【ep07】" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_ent"><mxGeometry x="4" y="40" width="292" height="232" as="geometry"/></mxCell>

        <mxCell id="c_weap" value="«struct» WeaponState" style="swimlane;html=1;rounded=0;startSize=34;fontSize=15;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="1210" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="weap1" value="+ hp = 100（钳 0 不死）&#10;+ magUsed / lastFireMs&#10;+ reloadUntilMs / bHasFired" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_weap"><mxGeometry x="4" y="40" width="202" height="70" as="geometry"/></mxCell>

        <mxCell id="c_hist" value="«struct» HistorySample【ep06】" style="swimlane;html=1;rounded=0;startSize=34;fontSize=15;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="790" y="1210" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="hist1" value="+ tMs : uint64（服务器接收时刻）&#10;+ x, y, z : float" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_hist"><mxGeometry x="4" y="40" width="252" height="50" as="geometry"/></mxCell>

        <!-- ═══ 域层纯函数与数据 ═══ -->
        <mxCell id="c_evt" value="«struct» MatchEvent" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1090" y="390" width="260" height="260" as="geometry"/></mxCell>
        <mxCell id="evt1" value="+ type : Start/Snap/Fire&#10;　/ Kill / Respawn / Ended【ep07】&#10;+ roomId / leavePlayerId&#10;+ roster[] / entities[]&#10;+ fire : FireResultData（21 号）&#10;+ killVictim / killKiller【ep07】&#10;+ respawnPid / spawnIndex&#10;　/ invulnMs / respawnDelayMs【ep07】&#10;+ endReason / scores[] : ScoreRow【ep07】" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_evt"><mxGeometry x="4" y="40" width="252" height="212" as="geometry"/></mxCell>

        <mxCell id="c_fj" value="«utility» fire_judge（纯函数集·零状态）" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1090" y="700" width="400" height="300" as="geometry"/></mxCell>
        <mxCell id="fj1" value="常量：kDamage=25 · kMag=30 · kReload=2500ms&#10;　　　kFireMinInterval=95ms · kMaxRange=10km&#10;　　　kMaxRewindMs=1000 · kEntityHistoryCap=32【ep06】&#10;　　　kRespawn=3s · kInvuln=2s · kKillLimit=10【ep07】&#10;　　　kNavCell=50 · kNavStep=45 · kNavInflate=34【ep07】" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_fj"><mxGeometry x="4" y="40" width="392" height="112" as="geometry"/></mxCell>
        <mxCell id="fj2" value="+ ConsumeWeaponGate(w, now) : FireGate&#10;+ DirectionFromYawPitch / RayOriginFromEntity&#10;+ CastRay(o, d, occ, others, hb) : FireVerdict&#10;+ RayCylinderVertical / RayBox / RaySphere&#10;+ DamageApply(hp)（钳 0 不死）&#10;+ SampleHistoryAt(h, n, head, t)【ep06】" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_fj"><mxGeometry x="4" y="156" width="392" height="136" as="geometry"/></mxCell>

        <mxCell id="c_geo" value="MapGeometry" style="swimlane;html=1;rounded=0;startSize=34;fontSize=16;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1090" y="1060" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="geo1" value="+ occluders : OccluderTable&#10;+ hitbox : r=34 / halfH=88&#10;+ spawnPoints[] : SpawnPoint【ep07】&#10;+ patrolPoints[] : Vec3【ep07】" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_geo"><mxGeometry x="4" y="40" width="242" height="92" as="geometry"/></mxCell>

        <!-- ═══ ep07 人机栈（域层纯函数 + 适配器驱动） ═══ -->
        <mxCell id="c_perc" value="«utility» perception（人机感知）" style="swimlane;html=1;rounded=0;startSize=34;fontSize=15;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1620" y="210" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="perc1" value="+ CanSee(occ, fromPos, fromYaw, chest)&#10;　（复用 fire_judge 求交——所见=所及）&#10;　位置采样=查历史环 now−250ms" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_perc"><mxGeometry x="4" y="40" width="312" height="62" as="geometry"/></mxCell>

        <mxCell id="c_brain" value="«utility» bot_brain（人机决策·纯函数）" style="swimlane;html=1;rounded=0;startSize=34;fontSize=15;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1620" y="380" width="320" height="230" as="geometry"/></mxCell>
        <mxCell id="brain1" value="enum BotState{Patrol, Engage,&#10;　Search, TakeCover}（FSM 纯单测）&#10;+ BotTuning / BotMemory / WorldView&#10;　/ BotIntent（纯数据 DTO）" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_brain"><mxGeometry x="4" y="40" width="312" height="92" as="geometry"/></mxCell>
        <mxCell id="brain2" value="+ Decide(view, state&, mem&, now, t)&#10;　→ BotIntent&#10;+ 像人旋钮：反应 250ms·误差 4°→1°&#10;　转身 360°/s 上限·遗忘 3s" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_brain"><mxGeometry x="4" y="136" width="312" height="88" as="geometry"/></mxCell>

        <mxCell id="c_nav" value="«utility» nav_grid（导航栅格·A*）" style="swimlane;html=1;rounded=0;startSize=34;fontSize=15;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1620" y="670" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="nav1" value="+ BuildNavGrid(occ)（真相源=occluders）&#10;+ GridLOS / FindPath（八向 A*·拉直）&#10;　身体高度带·膨胀 34cm·台阶 45cm 可跨" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_nav"><mxGeometry x="4" y="40" width="312" height="72" as="geometry"/></mxCell>

        <mxCell id="c_botdrv" value="«adapter» BotDriver（人机驱动·主线程）" style="swimlane;html=1;rounded=0;startSize=34;fontSize=15;fontStyle=1;dashed=1;fillColor=#e1f5fe;strokeColor=#0288d1;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1620" y="850" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="botdrv1" value="+ OnBotAdded / OnMatchStart / RemoveBot&#10;+ Tick(nowMs, match, lobby)（33ms）&#10;　感知→Decide→行动·全走真人同款入口&#10;− byRoom_（难度映射 BotTuning）" style="text;fontSize=15;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="c_botdrv"><mxGeometry x="4" y="40" width="312" height="112" as="geometry"/></mxCell>

